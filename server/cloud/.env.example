# ─── Облачный сервер (OpenRouter) — v2.2 ──────────────────────
# Получить бесплатный ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-ВАШ_КЛЮЧ_ЗДЕСЬ

# ─── HTTP-сервер ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Выбор модели OpenRouter ──────────────────────────────────
# CLOUD_PRESET: A | B | C | D
#   A — openrouter/free auto-router. Самый надёжный preset:
#       при недоступности одной модели OpenRouter сам переключит
#       на другую (дефолт).
#   B — qwen/qwen3-next-80b-a3b-instruct:free
#       Qwen3-Next 80B MoE, multilingual (явно поддерживает
#       русский), контекст 262K. Лучший выбор для русскоязычных
#       официальных документов.
#   C — google/gemma-4-31b-it:free
#       Gemma 4 31B Instruct, dense 30.7B, multilingual,
#       контекст 256K. Сильный по русскому.
#   D — nvidia/nemotron-3-super-120b-a12b:free
#       Nemotron 3 Super 120B MoE (12B активных), контекст 262K.
#       Hybrid Mamba-Transformer-MoE, сильный reasoning.
CLOUD_PRESET=A

# Можно явно перебить список моделей (CSV) — он будет
# использоваться с перебором по очереди вместо CLOUD_PRESET.
# Оставьте пустым для дефолта.
# OPENROUTER_MODELS=openrouter/free,qwen/qwen3-next-80b-a3b-instruct:free
#
# Полный список моделей и fallback-цепочек для каждого preset (A/B/C/D)
# определён в коде: server/shared/openrouter_client.py (словарь CLOUD_PRESETS).
# Если нужно поменять модели «навсегда» — правьте этот словарь.
# Если нужно поменять модели только для конкретной установки — используйте
# OPENROUTER_MODELS=... выше.

# Параметры запросов к OpenRouter
OPENROUTER_TIMEOUT=90
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=3000
# Заголовки HTTP-Referer и X-Title (нужны OpenRouter для квот).
OPENROUTER_REFERER=http://localhost
OPENROUTER_TITLE=AI LibreOffice Suggester

# ─── Логирование ──────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs
# Сколько дней хранить лог-файлы и аудит-записи (0 = без ограничений)
LOG_RETENTION_DAYS=30

# ─── Аудит запросов (кто, когда, какой текст, сколько исправлений) ───
AUDIT_ENABLED=true
AUDIT_DB=logs/audit.sqlite
# Если true, полный текст запроса/ответа не сохраняется (только метрики)
AUDIT_REDACT_TEXT=false

# ─── Rate limit (запросов в минуту с одного IP, 0 = отключить) ───
RATE_LIMIT_RPM=60

# ─── RAG (опционально) ────────────────────────────────────────
# Если включено, /suggest добавляет в промпт релевантные фрагменты
# из data/rag_store/, проиндексированные ранее через rag_cli.
# Используется для ссылок на НПА РФ (ГОСТ Р 7.0.97-2016,
# методические рекомендации Минюста, ведомственные регламенты).
# Требует доступа к Ollama (для эмбеддингов nomic-embed-text/bge-m3).
RAG_ENABLED=false
OLLAMA_URL=http://localhost:11434
RAG_STORE_DIR=data/rag_store
RAG_TOP_K=4
RAG_EMBED_MODEL=nomic-embed-text

# ─── Пользовательский словарь (whitelist терминов) ───────────
# REST API: /dict/list, /dict/add, /dict/remove.
# Модель не должна «исправлять» термины из этого списка
# (ЦСН, КС-2, имена организаций и т. п.).
USER_DICT_ENABLED=true
# AI_SUGGESTER_USER_DICT_PATH=data/user_dict.json

# ─── Что НЕ нужно настраивать в v2.2 ──────────────────────────
# Cloud-сервер сознательно упрощён по сравнению с local: морф-фильтр,
# морф-детектор, sage, LanguageTool и few-shot retrieval УДАЛЕНЫ,
# потому что сетевая модель сама справляется с этими классами ошибок.
# Не пытайтесь добавлять MORPH_*, LANGUAGETOOL_* или USE_FEW_SHOT —
# они не читаются.
