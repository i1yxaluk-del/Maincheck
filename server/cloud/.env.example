# ─── Облачный сервер (OpenRouter) ─────────────────────────────
# Получить бесплатный ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-ВАШ_КЛЮЧ_ЗДЕСЬ

# ─── HTTP-сервер ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Выбор модели OpenRouter (v2.1) ───────────────────────────
# CLOUD_PRESET: A | B | C | D
#   A — openrouter/free auto-router. Самый надёжный preset:
#       при недоступности одной модели OpenRouter сам переключит на
#       другую (дефолт).
#   B — qwen/qwen3-next-80b-a3b-instruct:free
#       Qwen3-Next 80B MoE, multilingual (явно поддерживает русский),
#       контекст 262K. Лучший выбор для русскоязычных документов.
#   C — google/gemma-4-31b-it:free
#       Gemma 4 31B Instruct, dense 30.7B, multilingual, контекст 256K.
#       Сильный по русскому, configurable thinking-mode (выключаем для GEC).
#   D — nvidia/nemotron-3-super-120b-a12b:free
#       Nemotron 3 Super 120B MoE (12B активных), контекст 262K.
#       Hybrid Mamba-Transformer-MoE, сильный reasoning.
#       Менее заточен под русский, но хорош для сложного контекста.
CLOUD_PRESET=A

# Можно явно перебить список моделей (CSV) — он будет использоваться
# с перебором по очереди вместо CLOUD_PRESET. Оставьте пустым для дефолта.
# OPENROUTER_MODELS=openrouter/free,qwen/qwen3-next-80b-a3b-instruct:free

# Параметры запросов к OpenRouter
OPENROUTER_TIMEOUT=90
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=3000
# Заголовки HTTP-Referer и X-Title (нужны OpenRouter для квот).
OPENROUTER_REFERER=http://localhost
OPENROUTER_TITLE=AI LibreOffice Suggester

# ─── Логирование ──────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs
# Сколько дней хранить лог-файлы и аудит-записи (0 = без ограничений)
LOG_RETENTION_DAYS=30

# ─── Аудит запросов (кто, когда, какой текст, сколько исправлений) ───
AUDIT_ENABLED=true
AUDIT_DB=logs/audit.sqlite
# Если true, полный текст запроса/ответа не сохраняется (только метрики)
AUDIT_REDACT_TEXT=false

# ─── Rate limit (запросов в минуту с одного IP, 0 = отключить) ───
RATE_LIMIT_RPM=60

# ─── RAG (опционально, v2.1) ──────────────────────────────────
# Если включено, /suggest добавляет в промпт релевантные фрагменты
# из data/rag_store/, проиндексированные ранее. Тот же интерфейс,
# что и в локальном сервере — store/embedder shared.
# Требует доступа к Ollama (для эмбеддингов nomic-embed-text/bge-m3).
RAG_ENABLED=false
OLLAMA_URL=http://localhost:11434
RAG_STORE_DIR=data/rag_store
RAG_TOP_K=4
RAG_EMBED_MODEL=nomic-embed-text

# ─── Few-shot retrieval из GEC-банка (опционально, v2.1) ──────
# Подмешивает top-K пар «неправильно → правильно» как примеры
# формата и стиля правок. Hybrid BM25 + dense retrieval (state-of-the-art
# для русского GEC, Sorokin & Nasyrova BEA 2025).
USE_FEW_SHOT=false
# GEC_BANK_FILES (CSV) — пути относительно server/cloud/ или абсолютные
GEC_BANK_FILES=../shared/gec_seed/gec_bank.jsonl,../shared/gec_seed/gec_bank_extended.jsonl,../shared/gec_seed/lexify_admin.jsonl
GEC_TOP_K=3
# Эмбеддер для GEC-банка (можно отличать от RAG_EMBED_MODEL).
GEC_EMBED_MODEL=nomic-embed-text
# Стратегия retrieval: hybrid (default) | dense | sparse
GEC_RETRIEVAL_MODE=hybrid
# Токенизатор для sparse-половины hybrid retrieval: word | trigram | both
GEC_BM25_TOKENIZER=both

# ─── Морфо-фильтр и детектор (pymorphy3, опционально, v2.1) ───
# MorphFilter: дроп галлюцинированных падежных «улучшений»
# («Подразделения» → «Подразделению» где нет повода).
# MorphDetector: обогащение CHANGES правилами numeral-noun
# («во 2-м кварталах» → «во 2-м квартале»), adj-noun и OOV.
# Требует pymorphy3 + pymorphy3-dicts-ru (см. requirements.txt).
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=true

# ─── Пользовательский словарь (whitelist терминов, v2.1) ─────
# REST API: /dict/list, /dict/add, /dict/remove.
# Дропает пункты CHANGES, в которых модель «исправляет» термины
# из словаря (ЦСН, КС-2, имена организаций и т. п.).
USER_DICT_ENABLED=true
# AI_SUGGESTER_USER_DICT_PATH=data/user_dict.json

# ─── LanguageTool-RU (опционально, v2.1) ─────────────────────
# Параллельный rule-based детектор. Добавляет в CHANGES стилистические
# и типографические правки (тире вместо дефиса, повторы слов и т. п.).
# Требует поднятого LT-сервера (см. ADMIN_GUIDE / RAG_GUIDE).
LANGUAGETOOL_ENABLED=false
LANGUAGETOOL_URL=http://localhost:8081
LANGUAGETOOL_LANGUAGE=ru-RU
LANGUAGETOOL_TIMEOUT=10
LANGUAGETOOL_ENABLED_CATEGORIES=STYLE,TYPOGRAPHY
# LANGUAGETOOL_DISABLED_CATEGORIES=
# LANGUAGETOOL_DISABLED_RULES=
