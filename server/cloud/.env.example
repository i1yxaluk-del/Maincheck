# ─── Облачный сервер (OpenAI-compatible providers) — v2.2.3 ─────────────
#
# С v2.2.3 cloud-сервер работает с любыми OpenAI-compatible провайдерами:
# OpenRouter, DeepSeek, Fireworks, Groq, Together, OpenAI, Mistral, и т. д.
# Перечисляете провайдеров в `CLOUD_PROVIDERS` в порядке предпочтения,
# для каждого — отдельные env-переменные с префиксом в верхнем регистре:
#   <NAME>_API_KEY    (обязательно)
#   <NAME>_BASE_URL   (опционально — для известных провайдеров есть дефолт)
#   <NAME>_MODELS     (CSV список моделей для перебора в случае fallback)
#
# Сервер перебирает все модели по порядку (provider1.models, provider2.models, ...)
# и останавливается на первом успешном ответе.
#
# Дефолт (если CLOUD_PROVIDERS не задан) — `openrouter`.
CLOUD_PROVIDERS=openrouter

# ─── HTTP-сервер ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Provider: OpenRouter ─────────────────────────────────────
# Получить бесплатный ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-ВАШ_КЛЮЧ_ЗДЕСЬ
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1     # опц., дефолт этот

# OpenRouter-specific: выбор моделей через preset A/B/C/D — удобные
# фабричные пресеты с fallback-цепочками. Полные списки лежат в
# server/shared/openrouter_client.py (словарь CLOUD_PRESETS).
# CLOUD_PRESET: A | B | C | D
#   A — openrouter/free auto-router. Самый надёжный preset (дефолт).
#   B — qwen/qwen3-next-80b-a3b-instruct:free (лучший по русскому).
#   C — google/gemma-4-31b-it:free.
#   D — nvidia/nemotron-3-super-120b-a12b:free.
CLOUD_PRESET=A

# Можно явно перебить список моделей OpenRouter (CSV) — он будет
# использоваться вместо CLOUD_PRESET.
# OPENROUTER_MODELS=openrouter/free,qwen/qwen3-next-80b-a3b-instruct:free

# Параметры запросов (общие для всех провайдеров).
OPENROUTER_TIMEOUT=90
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=3000
# Заголовки HTTP-Referer и X-Title (нужны OpenRouter для квот).
OPENROUTER_REFERER=http://localhost
OPENROUTER_TITLE=AI LibreOffice Suggester

# ─── Provider: DeepSeek (пример) ──────────────────────────────
# Чтобы включить DeepSeek как fallback-провайдер — раскомментируйте
# эти строки и добавьте `deepseek` в CLOUD_PROVIDERS:
#     CLOUD_PROVIDERS=openrouter,deepseek
# DEEPSEEK_API_KEY=sk-deepseek-ваш_ключ
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1            # опц., дефолт этот
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# ─── Provider: Fireworks (пример) ─────────────────────────────
# FIREWORKS_API_KEY=fw_ваш_ключ
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1  # опц., дефолт этот
# FIREWORKS_MODELS=accounts/fireworks/models/llama-v3p3-70b-instruct

# ─── Provider: Groq (пример) ──────────────────────────────────
# GROQ_API_KEY=gsk_ваш_ключ
# GROQ_BASE_URL=https://api.groq.com/openai/v1              # опц., дефолт этот
# GROQ_MODELS=llama-3.3-70b-versatile,mixtral-8x7b-32768

# ─── Provider: Together AI (пример) ───────────────────────────
# TOGETHER_API_KEY=ваш_ключ
# TOGETHER_BASE_URL=https://api.together.xyz/v1             # опц., дефолт этот
# TOGETHER_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ─── Provider: OpenAI (пример) ────────────────────────────────
# OPENAI_API_KEY=sk-ваш_ключ
# OPENAI_BASE_URL=https://api.openai.com/v1                 # опц., дефолт этот
# OPENAI_MODELS=gpt-4o-mini,gpt-4o

# ─── Provider: Mistral AI (пример) ────────────────────────────
# MISTRAL_API_KEY=ваш_ключ
# MISTRAL_BASE_URL=https://api.mistral.ai/v1                # опц., дефолт этот
# MISTRAL_MODELS=mistral-large-latest,mistral-medium-latest

# ─── Кастомный OpenAI-compatible провайдер ────────────────────
# Любой неизвестный провайдер: укажите имя в CLOUD_PROVIDERS и
# распишите <NAME>_API_KEY + <NAME>_BASE_URL + <NAME>_MODELS.
# Пример для вымышленного провайдера myllm:
#     CLOUD_PROVIDERS=openrouter,myllm
#     MYLLM_API_KEY=...
#     MYLLM_BASE_URL=https://api.myllm.example/v1
#     MYLLM_MODELS=model-x,model-y

# ─── Логирование ──────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs
# Сколько дней хранить лог-файлы и аудит-записи (0 = без ограничений)
LOG_RETENTION_DAYS=30

# ─── Аудит запросов (кто, когда, какой текст, сколько исправлений) ───
AUDIT_ENABLED=true
AUDIT_DB=logs/audit.sqlite
# Если true, полный текст запроса/ответа не сохраняется (только метрики)
AUDIT_REDACT_TEXT=false

# ─── Rate limit (запросов в минуту с одного IP, 0 = отключить) ───
RATE_LIMIT_RPM=60

# ─── RAG (опционально) ────────────────────────────────────────
# Если включено, /suggest добавляет в промпт релевантные фрагменты
# из data/rag_store/, проиндексированные ранее через rag_cli.
# Используется для ссылок на НПА РФ (ГОСТ Р 7.0.97-2016,
# методические рекомендации Минюста, ведомственные регламенты).
# Требует доступа к Ollama (для эмбеддингов nomic-embed-text/bge-m3).
RAG_ENABLED=false
OLLAMA_URL=http://localhost:11434
RAG_STORE_DIR=data/rag_store
RAG_TOP_K=4
RAG_EMBED_MODEL=nomic-embed-text

# ─── Пользовательский словарь (whitelist терминов) ───────────
# REST API: /dict/list, /dict/add, /dict/remove.
# Модель не должна «исправлять» термины из этого списка
# (ЦСН, КС-2, имена организаций и т. п.).
USER_DICT_ENABLED=true
# AI_SUGGESTER_USER_DICT_PATH=data/user_dict.json

# ─── Что НЕ нужно настраивать в v2.2 ──────────────────────────
# Cloud-сервер сознательно упрощён по сравнению с local: морф-фильтр,
# морф-детектор, sage, LanguageTool и few-shot retrieval УДАЛЕНЫ,
# потому что сетевая модель сама справляется с этими классами ошибок.
# Не пытайтесь добавлять MORPH_*, LANGUAGETOOL_* или USE_FEW_SHOT —
# они не читаются.
