[Unit]
Description=Maincheck v20 experimental llama.cpp JSON edit interpreter
After=network.target v20-llama-backend.service
Requires=v20-llama-backend.service

[Service]
Type=simple
User=service
WorkingDirectory=/home/service/llama/server/local
EnvironmentFile=/home/service/llama/server/local/.env.v20
Environment=PYTHONPATH=/home/service/llama/server
ExecStart=/home/service/llama/server/local/venv/bin/uvicorn v20.llama_json_app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
