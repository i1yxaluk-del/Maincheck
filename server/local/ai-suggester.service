[Unit]
Description=AI LibreOffice Suggester — Local Server
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=service
WorkingDirectory=/home/service/llama/server/local
Environment="PYTHONPATH=/home/service/llama/server"
AllowedCPUs=0-15
Environment="MALLOC_ARENA_MAX=2"
Environment="OMP_NUM_THREADS=8"
Environment="MKL_NUM_THREADS=8"
Environment="OPENBLAS_NUM_THREADS=8"
Environment="TOKENIZERS_PARALLELISM=false"
Environment="HF_HUB_DISABLE_TELEMETRY=1"
EnvironmentFile=-/home/service/llama/server/local/.env
ExecStart=/home/service/llama/server/local/venv/bin/uvicorn decision_app_v11:app --host 0.0.0.0 --port 8000
TimeoutStartSec=240
Restart=on-failure
RestartSec=5
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
