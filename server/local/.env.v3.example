# v5 benchmark-backed Russian GEC cascade. .env remains the single runtime selector.
LLM_PRESET=A

# A: SAGE + BEA2026 SyntErr Qwen3.5-0.8B GEC + T-lite full draft
# B: SAGE + BEA2026 SyntErr Qwen3.5-0.8B GEC + GigaChat full draft
# X: fast local SAGE + BEA2026 SyntErr Qwen3.5-0.8B GEC
# Y: max local recall: SAGE + BEA2026 GEC + T-lite + GigaChat drafts

OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=180
OLLAMA_WARMUP=true
OLLAMA_WARMUP_REQUIRED=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16

HYBRID_LLM_TIMEOUT=180
HYBRID_NUM_CTX=4096
HYBRID_NUM_PREDICT=512

# Fast Russian spelling/punctuation/case candidate generator (~386 MB weights).
SAGE_CORRECTOR_ENABLED=true
SAGE_CORRECTOR_MODEL=ai-forever/sage-fredt5-distilled-95m
SAGE_CORRECTOR_MAX_NEW_TOKENS=256
SAGE_CORRECTOR_MAX_INPUT_TOKENS=512
SAGE_CORRECTOR_NUM_BEAMS=1
SAGE_CORRECTOR_THREADS=2

# Measured Russian GEC specialist: Qwen3.5-0.8B + BEA2026 SyntErr -> LORuGEC LoRA.
RUSSIAN_GEC_ENABLED=true
RUSSIAN_GEC_BASE_MODEL=Qwen/Qwen3.5-0.8B
RUSSIAN_GEC_ADAPTER_REPO=synterr-nlp/bea2026-gec-adapters
RUSSIAN_GEC_ADAPTER_SUBFOLDER=v4_qwen35_08b_lorugec
RUSSIAN_GEC_MAX_NEW_TOKENS=256
RUSSIAN_GEC_MAX_INPUT_TOKENS=768
RUSSIAN_GEC_THREADS=4

# Optional external/local LanguageTool is no longer part of the default quality path.
LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=ru-RU

DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
