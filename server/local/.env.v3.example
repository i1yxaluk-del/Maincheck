# v3 hybrid editor. Keep the existing .env as the single runtime selector.
LLM_PRESET=A

# A: t-tech/T-lite-it-2.1:q4_K_M -> GigaChat judge
# B: hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:latest -> T-lite judge
# X: Qwen/Qwen3.5-4B (Transformers) -> GigaChat judge
# Y: Qwen/Qwen3.5-4B x2 -> T-lite judge + optional LanguageTool verifier

OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_REQUIRED=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16

HYBRID_LLM_TIMEOUT=300
HYBRID_NUM_CTX=4096
HYBRID_NUM_PREDICT=512

# Optional external/local LanguageTool HTTP server. Leave empty unless tested.
# Example: http://127.0.0.1:8081
LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=ru-RU

# Experimental Qwen3.5-4B
QWEN35_MODEL=Qwen/Qwen3.5-4B
QWEN35_MAX_NEW_TOKENS=768

DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
