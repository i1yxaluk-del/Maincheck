# v4 proofreading cascade. Existing .env remains the single runtime selector.
LLM_PRESET=A

# A: SAGE spell/punctuation + T-lite draft/diagnostic + GigaChat judge
# B: SAGE spell/punctuation + GigaChat draft/diagnostic + T-lite judge
# X: SAGE + GigaChat multi-candidate cascade
# Y: SAGE + two T-lite correction candidates + GigaChat judge

OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_REQUIRED=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16

HYBRID_LLM_TIMEOUT=300
HYBRID_NUM_CTX=4096
HYBRID_NUM_PREDICT=768

# Dedicated Russian spelling/punctuation model. It is only a candidate generator;
# final edits still pass through the existing DecisionEngine.
SAGE_CORRECTOR_ENABLED=true
SAGE_CORRECTOR_MODEL=ai-forever/sage-fredt5-distilled-95m
SAGE_CORRECTOR_MAX_NEW_TOKENS=256
SAGE_CORRECTOR_NUM_BEAMS=2

LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=ru-RU

DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
