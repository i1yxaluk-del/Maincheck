# v8 grammar-first Russian proofreader: deterministic grammar + SAGE + gated Qwen3.5 GEC.
LLM_PRESET=A

# A: grammar-first + SAGE + gated Qwen3.5 GEC; T-lite rescue only when grammar coverage is still weak
# B: same, with GigaChat rescue
# X: fast grammar-first local path
# Y: max recall with both Ollama rescues

OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_WARMUP=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16
HYBRID_LLM_TIMEOUT=30
HYBRID_NUM_CTX=3072
HYBRID_NUM_PREDICT=384

# Deterministic grammar is evaluated before expensive generation.
# Known high-confidence grammar hits suppress the GEC/rescue calls for that request.
LOCAL_GRAMMAR_GATE=true
LOCAL_GRAMMAR_GATE_CATEGORIES=rule-quantifier,rule-government,rule-agreement

# Dedicated Russian spelling/punctuation specialist (~95M).
SAGE_CORRECTOR_ENABLED=true
SAGE_CORRECTOR_MODEL=ai-forever/sage-fredt5-distilled-95m
SAGE_CORRECTOR_MAX_NEW_TOKENS=256
SAGE_CORRECTOR_MAX_INPUT_TOKENS=512
SAGE_CORRECTOR_NUM_BEAMS=1
SAGE_CORRECTOR_THREADS=2

# Russian GEC specialist in the EXISTING Ollama daemon; called only when the grammar gate does not fire.
OLLAMA_GEC_ENABLED=true
OLLAMA_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
OLLAMA_GEC_TIMEOUT=30
OLLAMA_GEC_NUM_CTX=2048
OLLAMA_GEC_NUM_PREDICT=256
OLLAMA_GEC_NUM_THREAD=16

# Generic rescue is a second opinion, never the primary grammar detector.
LOCAL_RESCUE_MIN_GRAMMAR_CANDIDATES=1
LOCAL_RESCUE_MIN_CANDIDATES=2
LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=ru-RU
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
