# v6 adaptive Russian proofreader. .env remains the single runtime selector.
LLM_PRESET=A

# A: rules + SAGE + ruBert MLM; T-lite only when local detectors are insufficient
# B: rules + SAGE + ruBert MLM; GigaChat only when local detectors are insufficient
# X: fast local path: rules + SAGE + ruBert MLM
# Y: same local path, with both Ollama rescue models enabled when needed

OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_WARMUP=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16
HYBRID_LLM_TIMEOUT=30
HYBRID_NUM_CTX=3072
HYBRID_NUM_PREDICT=384

# Dedicated Russian spelling/punctuation specialist (~95M).
SAGE_CORRECTOR_ENABLED=true
SAGE_CORRECTOR_MODEL=ai-forever/sage-fredt5-distilled-95m
SAGE_CORRECTOR_MAX_NEW_TOKENS=256
SAGE_CORRECTOR_MAX_INPUT_TOKENS=512
SAGE_CORRECTOR_NUM_BEAMS=1
SAGE_CORRECTOR_THREADS=2

# Russian masked-LM candidate detector. It proposes only one-word edits;
# unlike a generative GEC model it cannot reorder or paraphrase the sentence.
RUSSIAN_MLM_ENABLED=true
RUSSIAN_MLM_MODEL=ai-forever/ruBert-base
RUSSIAN_MLM_TOP_K=8
RUSSIAN_MLM_MAX_POSITIONS=40
RUSSIAN_MLM_BATCH=8
RUSSIAN_MLM_MIN_MARGIN=0.25
RUSSIAN_MLM_THREADS=4

# The BEA2026 Qwen3.5 LoRA is retained for experiments but is OFF by default.
# Production logs showed the adapter loading with missing target keys; do not
# treat it as a valid GEC specialist until the exact base/adapter pair is verified.
RUSSIAN_GEC_ENABLED=false
RUSSIAN_GEC_BASE_MODEL=Qwen/Qwen3.5-0.8B
RUSSIAN_GEC_ADAPTER_REPO=synterr-nlp/bea2026-gec-adapters
RUSSIAN_GEC_ADAPTER_SUBFOLDER=v4_qwen35_08b_lorugec

# Call the slower Ollama rescue only when local high-confidence sources found
# fewer than this many candidates.
LOCAL_RESCUE_MIN_CANDIDATES=2

LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=ru-RU
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
