# v3.1 hybrid Russian editor. Existing .env remains the single runtime selector.
LLM_PRESET=A

# A: t-tech/T-lite-it-2.1:q4_K_M -> GigaChat judge
# B: hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:latest -> T-lite judge
# X: text-only Russian GEC specialist -> GigaChat judge
# Y: two specialist GEC drafts -> T-lite judge + optional LanguageTool verifier

OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_REQUIRED=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16

HYBRID_LLM_TIMEOUT=300
HYBRID_NUM_CTX=4096
HYBRID_NUM_PREDICT=512

# Current experimental text-only specialist (no Pillow/Torchvision required).
GEC_SPECIALIST_MODEL=ReginaNasyrova/checkpoint_150_lora_grpo_upd_reward_GECExplanation-4B-sft-stage1-March2026
GEC_SPECIALIST_MAX_NEW_TOKENS=512

# Optional external/local LanguageTool HTTP server. Leave empty unless tested.
LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=ru-RU

DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
