# Hybrid GEC profile for Astra Linux / systemd.
# Primary model stays on the production-proven T-lite pipeline.
LLM_PRESET=A
MODEL_NAME=t-tech/T-lite-it-2.1:q4_K_M
NUM_THREADS=28
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_TIMEOUT=300
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# Existing primary GEC controls.
USE_FEW_SHOT=true
GEC_TOP_K=1
GEC_RETRIEVAL_MODE=hybrid
GEC_EMBED_MODEL=bge-m3
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=true
USER_DICT_ENABLED=true

# Compact auxiliary proofreading pass.
# The model is GGUF Q4_0 and can be pulled directly by Ollama.
SECONDARY_GEC_ENABLED=true
SECONDARY_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
SECONDARY_GEC_TIMEOUT=90
SECONDARY_GEC_KEEP_ALIVE=5m

# Keep other optional services disabled in the baseline hybrid profile.
LANGUAGETOOL_ENABLED=false
RAG_ENABLED=false
SAGE_VALIDATOR_ENABLED=false
