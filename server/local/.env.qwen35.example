# Qwen3.5-9B CPU profile for Broadwell Xeon E5-2690 v4 / 31 GB VMware guest
# Use with: ./start-qwen35.sh
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3.5:9b

# Keep CPU headroom for OS + FastAPI + Ollama runtime.
NUM_THREADS=28
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=768
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_TIMEOUT=300
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.05

# One correction authority: Qwen3.5 + deterministic post-filtering.
# Do not stack independent style/grammar generators by default.
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=false
LANGUAGETOOL_ENABLED=false

# Keep the retrieval layer, but use only one high-quality example to limit prompt drift.
USE_FEW_SHOT=true
GEC_TOP_K=1
GEC_RETRIEVAL_MODE=hybrid
GEC_EMBED_MODEL=bge-m3

# Domain RAG stays opt-in; it is reference context, not a second correction engine.
RAG_ENABLED=false

# If your build contains the optional SAGE validator, start in dry-run before enforce.
SAGE_VALIDATOR_ENABLED=false
SAGE_VALIDATOR_MODE=dryrun
