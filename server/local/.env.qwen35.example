# Qwen3.5-4B + morphological safety-net production profile for Astra Linux / systemd
# The running service loads /home/service/llama/server/local/.env via EnvironmentFile.
OLLAMA_URL=http://localhost:11434
LLM_PRESET=A
MODEL_NAME=qwen3.5:4b

# Broadwell host: keep current production thread count.
NUM_THREADS=28
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_TIMEOUT=300
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# DecisionEngine remains an available structured-output path for the dedicated
# decision_app entrypoint. The existing production unit may continue to use
# main:app unchanged.
DECISION_ENGINE_ENABLED=true
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=40
DECISION_MAX_BEFORE_CHARS=180

# Research adapter is documented/configured but not silently enabled in Ollama.
# Activating the PEFT adapter requires a separate Transformers/PEFT runtime or
# a pre-merged/converted model artifact.
GEC_ADAPTER_ENABLED=false
GEC_ADAPTER_REPO=synterr-nlp/bea2026-gec-adapters
GEC_ADAPTER_SUBFOLDER=v4_qwen35_4b_lorugec

# Preserve the existing retrieval layer from the production project.
USE_FEW_SHOT=true
GEC_BANK_FILES=../shared/gec_seed/gec_bank.jsonl,../shared/gec_seed/gec_bank_extended.jsonl,../shared/gec_seed/lexify_admin.jsonl
GEC_TOP_K=1
GEC_RETRIEVAL_MODE=hybrid
GEC_EMBED_MODEL=bge-m3
GEC_BM25_TOKENIZER=both

# Safety / auxiliary stages.
# MorphDetector is ON in the production profile because it catches high-confidence
# grammar classes that a generative GEC model can miss, including adjective+noun
# number/case disagreement such as «ночных наряда» -> «ночных нарядов».
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=true
NATASHA_ENABLED=true
LANGUAGETOOL_ENABLED=false
LANGUAGETOOL_URL=http://localhost:8081
LANGUAGETOOL_LANGUAGE=ru-RU
LANGUAGETOOL_TIMEOUT=10
LANGUAGETOOL_ENABLED_CATEGORIES=STYLE,TYPOGRAPHY
LANGUAGETOOL_DISABLED_CATEGORIES=
LANGUAGETOOL_DISABLED_RULES=
USER_DICT_ENABLED=true
RAG_ENABLED=false
SAGE_VALIDATOR_ENABLED=false
SAGE_VALIDATOR_MODE=dryrun
SAGE_VALIDATOR_DOMAIN=admin
SAGE_VALIDATOR_CATEGORIES=орфограф
SAGE_VALIDATOR_DEVICE=cpu
SAGE_VALIDATOR_MAX_INPUT_LEN=512
SAGE_VALIDATOR_WARMUP=true

# Existing logging / audit settings remain compatible with the current service.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30
AUDIT_ENABLED=true
AUDIT_DB=logs/audit.sqlite
AUDIT_REDACT_TEXT=false
