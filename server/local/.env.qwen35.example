# Qwen3.5-4B GEC + DecisionEngine CPU profile for Broadwell Xeon E5-2690 v4 / 31 GB VMware guest
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen3.5:4b
NUM_THREADS=28
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT=240
OLLAMA_WARMUP=true
OLLAMA_WARMUP_TIMEOUT=240
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# DecisionEngine: LLM returns edit candidates as structured JSON; server applies only validated edits.
DECISION_ENGINE_ENABLED=true
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=40
DECISION_MAX_BEFORE_CHARS=180

# Runnable backend is official Ollama Qwen3.5-4B Q4_K_M (~3.4 GB).
# The research GEC LoRA below is adapter-ready but is NOT silently assumed to be active.
GEC_ADAPTER_ENABLED=false
GEC_ADAPTER_REPO=synterr-nlp/bea2026-gec-adapters
GEC_ADAPTER_SUBFOLDER=v4_qwen35_4b_lorugec

# Keep retrieval, but do not let independent engines mutate the final text.
USE_FEW_SHOT=true
GEC_TOP_K=1
GEC_RETRIEVAL_MODE=hybrid
GEC_EMBED_MODEL=bge-m3

# Deterministic safety layers.
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=false
LANGUAGETOOL_ENABLED=false
USER_DICT_ENABLED=true
RAG_ENABLED=false
SAGE_VALIDATOR_ENABLED=false
SAGE_VALIDATOR_MODE=dryrun
