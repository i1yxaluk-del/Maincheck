# Experimental preset Z: strong reasoner -> fast result extractor.
LLM_PRESET=Z
REASONING_CASCADE_ENABLED=true

# 7.6B Qwen-based DeepSeek-R1 distill. Q4_K_M is about 4.7 GiB and fits the
# 31 GiB server together with the 0.8B extractor and Ollama runtime.
REASONING_MODEL=deepseek-r1:7b-qwen-distill-q4_K_M
REASONING_EXTRACTOR_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
REASONING_TIMEOUT=120
REASONING_EXTRACT_TIMEOUT=30
REASONING_NUM_CTX=4096
REASONING_NUM_PREDICT=1024
REASONING_NUM_THREADS=16
REASONING_MAX_SENTENCES=6

# Z deliberately disables the old generative stages to avoid running four CPU
# models for the same sentence. Deterministic v9/v10 rules remain enabled.
SAGE_CORRECTOR_ENABLED=false
OLLAMA_GEC_ENABLED=false
LOCAL_RESCUE_MODE=never

RULE_AGREEMENT_ENABLED=true
RULE_PREDICATIVE_ENABLED=true
DICT_SPELLCHECK_ENABLED=true
GENERATIVE_GUARD_ENABLED=true
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP=false
NUM_THREADS=16
AUDIT_ENABLED=true
USER_DICT_ENABLED=true
