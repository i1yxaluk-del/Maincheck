# ─── Локальный сервер (Ollama) ────────────────────────────────
OLLAMA_URL=http://localhost:11434

# v2.0-a: A/B/C переключение LLM через preset (быстрая смена модели для
# тестирования). LLM_PRESET выбирает MODEL_NAME автоматически. Если хотите
# использовать модель вне presets — задайте MODEL_NAME явно, он перебивает
# preset (см. ниже).
#
# Доступные presets:
#   A — t-tech/T-lite-it-2.1:q4_K_M (baseline, default, 8B dense)
#       Русскоязычный instruct-tune от T-Bank на базе Qwen3-8B (дек. 2025).
#       Warm ~30-50 с CPU Broadwell, 5 ГБ Q4_K_M.
#       `ollama pull t-tech/T-lite-it-2.1:q4_K_M`
#
#   B — hf.co/yandex/YandexGPT-5-Lite-8B-instruct-GGUF:Q4_K_M (8B dense)
#       F0.5=83% на LORuGEC bench (Sorokin & Nasyrova, ACL BEA 2025).
#       Прямая замена T-lite по архитектуре (8B → 8B), ожидается та же
#       latency. Apache 2.0 совместимая лицензия от Yandex.
#       `ollama pull hf.co/yandex/YandexGPT-5-Lite-8B-instruct-GGUF:Q4_K_M`
#
#   C — hf.co/ai-sage/GigaChat-3.1-Lightning-10B-A1.8B-Instruct-GGUF:Q4_K_M
#       MoE 10B параметров, 1.8B active per token (24 марта 2026, ai-sage).
#       MIT лицензия, llama.cpp поддержка с 12 марта 2026. Должна быть
#       заметно быстрее T-lite на CPU из-за MoE (меньше FLOPs/token).
#       `ollama pull hf.co/ai-sage/GigaChat-3.1-Lightning-10B-A1.8B-Instruct-GGUF:Q4_K_M`
#
# Внимание: hf.co/ ollama-пуллы требуют Ollama ≥ 0.3. Tag для B/C может
# измениться — проверьте через `ollama search` или браузер на HuggingFace.
# Если pull не отрабатывает — установите MODEL_NAME явно с актуальным тэгом.
#
# Старые альтернативы (не входят в presets, но работают через MODEL_NAME):
#   qwen2.5:14b   — стабильный baseline 2025, 9 ГБ, ~80 с
#   qwen2.5:32b   — старый флагман 2025, 19 ГБ, ~100 с
#   forzer/GigaChat3-10B-A1.8B — старый GigaChat3 (НЕ 3.1), ломает формат
LLM_PRESET=A

# Явный override: если задан — перебивает LLM_PRESET. Пустое значение или
# отсутствие переменной = preset выбирается из LLM_PRESET. Полезно для
# тестирования других моделей без правки кода presets.
# MODEL_NAME=

# Потоков CPU. Оставить 4 ядра ОС.
# ВАЖНО на серверах с несколькими сокетами/NUMA-нодами: ставьте число ядер
# одного сокета (обычно 16), а не суммарное. Cross-NUMA трафик в Ollama
# тормозит инференс в 2–3 раза. Проверить: `lscpu | grep NUMA`.
NUM_THREADS=28

# Размер окна контекста (input + output в токенах). 4096 — стандарт qwen2.5,
# но если ваши тексты редко длиннее 2 КБ, оставьте 2048 — это даёт ~2×
# прирост скорости на CPU без потери качества.
OLLAMA_NUM_CTX=2048

# Жёсткий лимит длины ответа в токенах. Без лимита Ollama иногда
# генерирует длинные «развёрнутые» комментарии. 1024 (~3000 символов)
# с запасом покрывают типовой исправленный фрагмент + блок ===CHANGES===.
OLLAMA_NUM_PREDICT=1024

# Таймаут запроса к Ollama в секундах. Должен быть БОЛЬШЕ клиентского
# (Settings.xba GetTimeout, по умолчанию 250), иначе клиент успеет
# отвалиться раньше сервера. 300 с покрывает первую загрузку 30B-модели
# с диска (~90 с) плюс генерацию (~30 с) с большим запасом.
OLLAMA_TIMEOUT=300

# Прогревать модель при старте сервера: один минимальный chat-запрос,
# чтобы веса оказались в RAM ДО первого пользовательского запроса.
# True (по умолчанию) — рекомендуется. False — экономит RAM при старте,
# но первый пользовательский запрос будет медленнее на 30–90 с.
OLLAMA_WARMUP=true
# Таймаут самого прогрева. Если модель тяжёлая или диск медленный —
# по умолчанию 300 (хватает даже на Broadwell); на AVX-512 можно снизить до 120.
OLLAMA_WARMUP_TIMEOUT=300

# Сколько модель остаётся в RAM после ответа. Без этого 30B-модель
# выгружается и каждый следующий запрос ждёт ~30–90 с.
OLLAMA_KEEP_ALIVE=30m

# qwen3 по умолчанию пишет длинный <think>…</think> перед ответом
# (минуты вычислений). Для правки текста это лишнее — оставляем false.
# Установите true только если хотите получить полное reasoning от модели
# (требует Ollama ≥ 0.9).
OLLAMA_THINK=false

# Температура сэмплинга. Дефолт 0 — greedy decoding (детерминирован между
# запросами). До v1.6.10 хардкодилось 0.1, что давало малую, но
# воспроизводимую вариативность ответа: одинаковый текст мог получить
# разные CHANGES (в v1.6.8 ablation: run1=1 пункт detailed,
# run2=3 пункта diff-reconstruction). Это мешало диагностике регрессий.
# 0 — рекомендуется для GEC. Поднимите до 0.1-0.3 для exploration.
OLLAMA_TEMPERATURE=0

# v1.7: морфологический фильтр падежных «улучшений» через pymorphy3.
# Закрывает класс галлюцинаций T-lite, который не ловит ни ё-фильтр,
# ни _drop_changes_not_in_text: модель «исправляет» «Подразделения» →
# «Подразделению», хотя обе формы валидны и контекст не требует именно
# дательного. Если pymorphy3 не установлен — фильтр тихо отключается.
# Установите false если хотите видеть «сырые» правки модели для
# диагностики. Подробности: server/shared/morph_filter.py.
MORPH_FILTER_ENABLED=true

# v1.9: natasha dependency-parser для синтаксического анализа.
# Заменяет ручные skip-rules v1.8.5 на универсальную проверку через
# дерево зависимостей. Закрывает классы FP «причастие+агенс_в_твор.»,
# «предлог+местоим+сущ», а также КЛАССЫ КОТОРЫЕ ЕЩЁ НЕ ВСПЛЫЛИ
# (длинные параллельные обороты, нестандартный порядок слов и т.д.) —
# одним правилом, без новых hardcoded паттернов.
#
# Latency: +8-50 мс warm на text 700 chars (бенчмарк 04.05.2026).
# RAM: +150 МБ (slovnet news-models). Загрузка лениво при первом
# /suggest — startup сервера не страдает.
#
# Зависимости: `pip install natasha` (~150 МБ + slovnet weights).
# Если natasha не установлена — парсер тихо отключается, и morph_detector
# / morph_filter откатываются на v1.8.5 hardcoded skip-rules.
# Установите false для отключения без удаления зависимости (полезно
# для A/B-сравнения качества).
NATASHA_ENABLED=true

# ─── RAG (обучение на ведомственных документах) ───────────────
# Если true — каждый запрос обогащается контекстом из проиндексированных документов
RAG_ENABLED=false
RAG_STORE_DIR=data/rag_store
RAG_DOCS_DIR=data/docs
RAG_TOP_K=4
# Модель эмбеддингов для Ollama (ollama pull nomic-embed-text)
RAG_EMBED_MODEL=nomic-embed-text

# ─── Few-shot retrieval (v1.6, GEC Bank) ──────────────────────
# Вместо того чтобы надеяться на zero-shot-интуицию модели, на каждый запрос
# подмешиваем top-K похожих примеров «неправильно → правильно» из банка.
# По методологии Sorokin & Nasyrova (BEA @ ACL 2025) это повышает F0.5 на
# LORuGEC с ~55 % (0-shot) до ~83 % (5-shot GECToR retrieval).
#
# Seed-банк (data/gec_bank.jsonl) — 288 пар из LORuGEC, 48 правил русской
# пунктуации и орфографии. Цитирование обязательно: Sorokin & Nasyrova 2025,
# https://github.com/ReginaNasyrova/LORuGEC
#
# Когда подключите корпус ведомственных документов, добавьте свой JSONL
# через запятую:
#   GEC_BANK_FILES=data/gec_bank.jsonl,data/gec_bank_agency.jsonl
# Формат каждой строки: {"wrong": "…", "right": "…", "rule": "…",
#                         "definition": "…", "section": "Punctuation"}
# С v1.6.4 значение по умолчанию — true: расширенный банк (927 пар) проверен
# на T-lite 8B и даёт 4/4 на эталоне Росгвардии за 75 с (см. ЖУРНАЛ_v1.6.md
# раздел v1.6.1). Включён по умолчанию для всех новых установок.
USE_FEW_SHOT=true
# Путь относительно server/local/. Можно несколько через запятую —
# например, seed-банк + расширенный + ваш ведомственный.
# По умолчанию подключаем три файла из репозитория:
#   • 288 базовых LORuGEC (gec_bank.jsonl)
#   • 639 расширенных LORuGEC (gec_bank_extended.jsonl)
#   • 1623 морфо-агрементов из alexanderpl/Lexify_RuGEC (lexify_admin.jsonl) —
#     подключено в v1.7.2, закрывает дыру в Grammar (число подлежащего/сказуемого,
#     случаи после «во 2-м», согласование однородных и т.д.).
# Итого ~2550 пар.
GEC_BANK_FILES=../shared/gec_seed/gec_bank.jsonl,../shared/gec_seed/gec_bank_extended.jsonl,../shared/gec_seed/lexify_admin.jsonl
# Сколько примеров подмешивать в промпт. 1 — лёгкий буст без потери latency,
# 2-3 — рекомендовано когда у вас банк >500 пар и домен узкий.
# Больше примеров → длиннее промпт → медленнее инференс на CPU; на CPU
# Broadwell каждый дополнительный shot добавляет ~15-25 с к latency.
GEC_TOP_K=1
# Эмбеддер для GEC-банка. С v1.6.6 дефолт — bge-m3 (1024-dim, мультиязычный):
# на проде Росгвардии 5 мая 2026 он поднял качество с 2/4 точно + 2/4 альт.
# до **4/4 точно** при той же latency 50-71 с (см. ЖУРНАЛ_v1.6.md, v1.6.6).
# nomic-embed-text оставлен как fallback на случай, если bge-m3 не скачан
# (`ollama pull bge-m3`, ~600 МБ): просто не задавайте GEC_EMBED_MODEL и он
# подхватит значение RAG_EMBED_MODEL.
#
# Можно задать отдельно от RAG_EMBED_MODEL — выгодно когда:
#   • RAG_EMBED_MODEL=nomic-embed-text оптимален для длинных документов,
#     а для коротких пар правок точнее bge-m3.
#   • Хотите безопасно тестировать новый эмбеддер на GEC, не трогая RAG.
# Смена модели здесь — fingerprint кэша меняется → автоматическая
# переиндексация (~7-15 мин на CPU Broadwell для 927 пар, потом disk-cache).
# Доступные опции (требуется `ollama pull <model>`):
#   bge-m3               — 1024-dim, мультиязычный, на русском GEC лучший (default)
#   nomic-embed-text     — 768-dim, англо-русский, fallback / прежний дефолт v1.6.3
#   mxbai-embed-large    — 1024-dim, англо-ориентирован, медленнее
GEC_EMBED_MODEL=bge-m3

# Стратегия retrieval (с v1.6.7):
#   hybrid — RRF dense (cosine, bge-m3) + sparse (BM25) — дефолт.
#            На длинных официальных текстах dense часто промахивается,
#            потому что предметная лексика («КС-2», «государственный
#            контракт», «млн рублей») доминирует над грамматическим
#            сигналом. BM25 ловит редкие словоформы напрямую («стоимостей»,
#            «выполненной», «не предусмотренной»), и фьюжн через RRF
#            (Reciprocal Rank Fusion, k=60) выдвигает релевантные пары
#            в топ. См. Sorokin & Nasyrova (BEA 2025), Tang et al. (2024),
#            а также tim-ponomarev/hybrid-rag (production legaltech 2026).
#            Latency-impact: +5-15 мс/запрос (BM25-индекс в RAM, ~2-5 МБ).
#   dense  — pure cosine, поведение v1.6.6 (откат, если на каком-то корпусе
#            hybrid вдруг хуже).
#   sparse — pure BM25, для ablation-тестов.
GEC_RETRIEVAL_MODE=hybrid

# v1.7: Токенизатор для sparse-половины hybrid retrieval (BM25).
#   word    — токены = словоформы (поведение v1.6).
#   trigram — char-trigram-токенизация (повышает recall на
#             морфологически близких парах: «стоимостей» ↔ «стоимости»
#             — общие триграммы «$ст», «сто», «тои», ...).
#   both    — параллельные word+trigram индексы, скоры суммируются.
# Дефолт `both` (рекомендуется): word ловит точные совпадения цитат,
# trigram — морфологические близости. RAM-overhead ~5-10 МБ для 894
# пар, latency на построении +30-60 мс при старте, на запросе
# пренебрежимо. Установите `word` для отката к v1.6 поведению, если
# подозреваете регрессию.
GEC_BM25_TOKENIZER=both

# ─── Логирование ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# ─── Аудит запросов ───────────────────────────────────────────
AUDIT_ENABLED=true
AUDIT_DB=logs/audit.sqlite
AUDIT_REDACT_TEXT=false

# ─── v1.8a: morph-детектор грамматических ошибок ──────────────
# pymorphy3-based детектор, который запускается ПОСЛЕ модели на raw_text
# и добавляет в CHANGES пропущенные ошибки трёх классов:
#   1) numeral-noun disagreement (например, «во 2-м кварталах»),
#   2) adj-noun disagreement     (например, «капитальных ремонтова»),
#   3) OOV-слова — отсутствуют в словаре pymorphy3 и не похожи на
#      аббревиатуру / имя собственное / слово из user_dict.
# Latency: <50 мс на 700 chars. Без новых зависимостей (pymorphy3 уже
# стоит для morph-фильтра v1.7+). Откат: установите `false`.
MORPH_DETECTOR_ENABLED=true

# ─── v1.8b: пользовательский словарь ──────────────────────────
# Сотрудник через UI расширения добавляет термины (аббревиатуры,
# служебные слова, исключения) в словарь сервера. Слова инжектятся
# в SYSTEM_PROMPT и в whitelist morph-детектора, и фильтруются из
# CHANGES (case-insensitive). REST API: GET /dict/list, POST /dict/add,
# POST /dict/remove. Подробности: Инструкции/USER_DICT_GUIDE.md.
# Откат: установите `false`. Файл `data/user_dict.json` при этом не
# трогается — можно вернуть включением обратно.
USER_DICT_ENABLED=true

# Путь к файлу словаря. По умолчанию `data/user_dict.json` относительно
# корня репозитория. Можно указать абсолютный путь, если хранение в
# другом месте (бэкап-том, общий диск).
# AI_SUGGESTER_USER_DICT_PATH=/var/lib/ai_suggester/user_dict.json

# ─── v1.8c: sage-95m post-валидатор ───────────────────────────
# ВНИМАНИЕ: sage уже тестировалась как primary corrector (см.
# ЖУРНАЛ_v1.6.md PoC от 30.04.2026) — на структурной пунктуации не
# работает, стабильно галлюцинирует числа, обучена на типо/орфо-ошибках.
# Поэтому в v1.8c она используется ТОЛЬКО как узкий пост-фильтр для
# класса «орфография», и по умолчанию работает в DRY-RUN режиме (только
# логирует verdict'ы, ничего не дропает).
#
# Рекомендованный rollout:
#   1) Включить ENABLED=true, MODE=dryrun (default) на 1 неделю.
#   2) Проанализировать `journalctl -u ai-suggester | grep Sage` —
#      посмотреть, как часто verdict=DISAGREE для орфо-правок.
#   3) Если sage уверенно ловит FP T-lite (и не ловит TP) — MODE=enforce.
#   4) Если sage даёт ложные DISAGREE на TP — оставить dryrun или выключить.
#
# Зависимости: `pip install transformers torch sentencepiece` (≈1.5 ГБ).
# Без них валидатор отключается автоматически (no-op).
SAGE_VALIDATOR_ENABLED=false
# dryrun = только логируем verdict в journalctl, ничего не дропаем (default).
# enforce = реально дропаем правки по verdict + domain + categories.
SAGE_VALIDATOR_MODE=dryrun
# admin = дропаем ТОЛЬКО при явном DISAGREE (recall важнее, default).
# general = дропаем DISAGREE и UNKNOWN (precision важнее).
SAGE_VALIDATOR_DOMAIN=admin
# Categories — substring-фильтр по тексту правки после «|». Sage обучена
# на орфографии, для согласования/управления ненадёжна. Пустая строка =
# все категории. Default: только «орфограф» (даже подстрока «орфограф»
# матчит «орфография — пропущена буква»).
SAGE_VALIDATOR_CATEGORIES=орфограф
# Override модели (полезно для экспериментов с другими GEC-чекпойнтами).
# SAGE_VALIDATOR_MODEL=ai-forever/sage-fredt5-distilled-95m
# CPU достаточно для 95M, на GPU latency ≤1 с (требует CUDA-PyTorch).
SAGE_VALIDATOR_DEVICE=cpu
# Максимальная длина входа в токенах (FRED-T5 контекст ≤512).
SAGE_VALIDATOR_MAX_INPUT_LEN=512
# Один forward pass на старте, чтобы первый /suggest не страдал на cold.
SAGE_VALIDATOR_WARMUP=true

# v2.0-b: LanguageTool-RU параллельный rule-based детектор.
# Стучит в локальный LanguageTool-сервер (Java/Docker) и добавляет в
# CHANGES стилистические + типографские правки, которые T-lite/MorphDetector
# не дают (тире вместо дефиса, русские кавычки «…», повторы слов,
# канцеляризмы и т.п.). 930+ правил для русского.
#
# Если сервер недоступен или LANGUAGETOOL_ENABLED=false — /suggest
# продолжает работу без LT-правок (graceful fallback).
#
# Установка LT-сервера: см. Инструкции/LANGUAGETOOL.md
#   быстрый вариант (Docker):
#     docker run -d --name lt --restart unless-stopped \
#       -p 8081:8010 erikvl87/languagetool:6.4
#
# Безопасность: НИКОГДА не указывайте LANGUAGETOOL_URL на api.languagetool.org
# (публичный SaaS, не GDPR-safe). Только локальный self-hosted.
LANGUAGETOOL_ENABLED=false
LANGUAGETOOL_URL=http://localhost:8081
LANGUAGETOOL_LANGUAGE=ru-RU
# Таймаут одного запроса /v2/check. Обычно достаточно 10 с.
LANGUAGETOOL_TIMEOUT=10
# Категории — CSV. Default: STYLE + TYPOGRAPHY (не дублируем грамматику
# и опечатки — это T-lite + MorphDetector). Полный список:
# https://community.languagetool.org/rule/list?lang=ru
# Пустая строка = все категории.
LANGUAGETOOL_ENABLED_CATEGORIES=STYLE,TYPOGRAPHY
# Отключённые категории (CSV). Перебивает enabled_categories.
LANGUAGETOOL_DISABLED_CATEGORIES=
# Отключённые правила (CSV, по rule.id). Полезно когда конкретное правило
# даёт много FP в админ-текстах.
LANGUAGETOOL_DISABLED_RULES=
