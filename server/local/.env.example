# ─── Локальный сервер (Ollama) ────────────────────────────────
OLLAMA_URL=http://localhost:11434

# Рекомендуется (v1.5, апрель 2026): t-tech/T-lite-it-2.1:q4_K_M — официальный
# русскоязычный fine-tune от T-Bank на базе Qwen3-8B, выпущен в декабре 2025.
# На CPU Broadwell даёт warm-ответ за 30–50 с (в 2× быстрее qwen2.5:14b
# при идентичном качестве исправлений), чистый формат ===CORRECTED===/===CHANGES===,
# малая склонность к галлюцинациям на официально-деловом стиле.
# Размер ~5 ГБ (Q4_K_M), оставляет запас RAM под другие процессы.
#
# Альтернативы:
#   qwen2.5:14b           — стабильный baseline 2025, 9 ГБ, ~80 с (запасной вариант)
#   qwen2.5:32b           — старый флагман 2025, 19 ГБ, ~100 с (если T-lite не подходит)
#   forzer/GigaChat3-10B-A1.8B — MoE от Сбера, ~30 с, но ломает формат ответа
#   qwen3:30b-a3b-instruct-2507 — Qwen3 MoE-instruct без thinking-режима, требует
#       запас памяти в одной NUMA-ноде (см. Инструкции/LOCAL_MODEL.md)
MODEL_NAME=t-tech/T-lite-it-2.1:q4_K_M

# Потоков CPU. Оставить 4 ядра ОС.
# ВАЖНО на серверах с несколькими сокетами/NUMA-нодами: ставьте число ядер
# одного сокета (обычно 16), а не суммарное. Cross-NUMA трафик в Ollama
# тормозит инференс в 2–3 раза. Проверить: `lscpu | grep NUMA`.
NUM_THREADS=28

# Размер окна контекста (input + output в токенах). 4096 — стандарт qwen2.5,
# но если ваши тексты редко длиннее 2 КБ, оставьте 2048 — это даёт ~2×
# прирост скорости на CPU без потери качества.
OLLAMA_NUM_CTX=2048

# Жёсткий лимит длины ответа в токенах. Без лимита Ollama иногда
# генерирует длинные «развёрнутые» комментарии. 1024 (~3000 символов)
# с запасом покрывают типовой исправленный фрагмент + блок ===CHANGES===.
OLLAMA_NUM_PREDICT=1024

# Таймаут запроса к Ollama в секундах. Должен быть БОЛЬШЕ клиентского
# (Settings.xba GetTimeout, по умолчанию 250), иначе клиент успеет
# отвалиться раньше сервера. 300 с покрывает первую загрузку 30B-модели
# с диска (~90 с) плюс генерацию (~30 с) с большим запасом.
OLLAMA_TIMEOUT=300

# Прогревать модель при старте сервера: один минимальный chat-запрос,
# чтобы веса оказались в RAM ДО первого пользовательского запроса.
# True (по умолчанию) — рекомендуется. False — экономит RAM при старте,
# но первый пользовательский запрос будет медленнее на 30–90 с.
OLLAMA_WARMUP=true
# Таймаут самого прогрева. Если модель тяжёлая или диск медленный —
# по умолчанию 300 (хватает даже на Broadwell); на AVX-512 можно снизить до 120.
OLLAMA_WARMUP_TIMEOUT=300

# Сколько модель остаётся в RAM после ответа. Без этого 30B-модель
# выгружается и каждый следующий запрос ждёт ~30–90 с.
OLLAMA_KEEP_ALIVE=30m

# qwen3 по умолчанию пишет длинный <think>…</think> перед ответом
# (минуты вычислений). Для правки текста это лишнее — оставляем false.
# Установите true только если хотите получить полное reasoning от модели
# (требует Ollama ≥ 0.9).
OLLAMA_THINK=false

# Температура сэмплинга. Дефолт 0 — greedy decoding (детерминирован между
# запросами). До v1.6.10 хардкодилось 0.1, что давало малую, но
# воспроизводимую вариативность ответа: одинаковый текст мог получить
# разные CHANGES (в v1.6.8 ablation: run1=1 пункт detailed,
# run2=3 пункта diff-reconstruction). Это мешало диагностике регрессий.
# 0 — рекомендуется для GEC. Поднимите до 0.1-0.3 для exploration.
OLLAMA_TEMPERATURE=0

# v1.7: морфологический фильтр падежных «улучшений» через pymorphy3.
# Закрывает класс галлюцинаций T-lite, который не ловит ни ё-фильтр,
# ни _drop_changes_not_in_text: модель «исправляет» «Подразделения» →
# «Подразделению», хотя обе формы валидны и контекст не требует именно
# дательного. Если pymorphy3 не установлен — фильтр тихо отключается.
# Установите false если хотите видеть «сырые» правки модели для
# диагностики. Подробности: server/shared/morph_filter.py.
MORPH_FILTER_ENABLED=true

# ─── RAG (обучение на ведомственных документах) ───────────────
# Если true — каждый запрос обогащается контекстом из проиндексированных документов
RAG_ENABLED=false
RAG_STORE_DIR=data/rag_store
RAG_DOCS_DIR=data/docs
RAG_TOP_K=4
# Модель эмбеддингов для Ollama (ollama pull nomic-embed-text)
RAG_EMBED_MODEL=nomic-embed-text

# ─── Few-shot retrieval (v1.6, GEC Bank) ──────────────────────
# Вместо того чтобы надеяться на zero-shot-интуицию модели, на каждый запрос
# подмешиваем top-K похожих примеров «неправильно → правильно» из банка.
# По методологии Sorokin & Nasyrova (BEA @ ACL 2025) это повышает F0.5 на
# LORuGEC с ~55 % (0-shot) до ~83 % (5-shot GECToR retrieval).
#
# Seed-банк (data/gec_bank.jsonl) — 288 пар из LORuGEC, 48 правил русской
# пунктуации и орфографии. Цитирование обязательно: Sorokin & Nasyrova 2025,
# https://github.com/ReginaNasyrova/LORuGEC
#
# Когда подключите корпус ведомственных документов, добавьте свой JSONL
# через запятую:
#   GEC_BANK_FILES=data/gec_bank.jsonl,data/gec_bank_agency.jsonl
# Формат каждой строки: {"wrong": "…", "right": "…", "rule": "…",
#                         "definition": "…", "section": "Punctuation"}
# С v1.6.4 значение по умолчанию — true: расширенный банк (927 пар) проверен
# на T-lite 8B и даёт 4/4 на эталоне Росгвардии за 75 с (см. ЖУРНАЛ_v1.6.md
# раздел v1.6.1). Включён по умолчанию для всех новых установок.
USE_FEW_SHOT=true
# Путь относительно server/local/. Можно несколько через запятую —
# например, seed-банк + расширенный + ваш ведомственный.
# По умолчанию подключаем оба файла из репозитория: 288 базовых + 639 LORuGEC =
# ~927 пар суммарно (см. tools/build_gec_bank/README.md).
GEC_BANK_FILES=../shared/gec_seed/gec_bank.jsonl,../shared/gec_seed/gec_bank_extended.jsonl
# Сколько примеров подмешивать в промпт. 1 — лёгкий буст без потери latency,
# 2-3 — рекомендовано когда у вас банк >500 пар и домен узкий.
# Больше примеров → длиннее промпт → медленнее инференс на CPU; на CPU
# Broadwell каждый дополнительный shot добавляет ~15-25 с к latency.
GEC_TOP_K=1
# Эмбеддер для GEC-банка. С v1.6.6 дефолт — bge-m3 (1024-dim, мультиязычный):
# на проде Росгвардии 5 мая 2026 он поднял качество с 2/4 точно + 2/4 альт.
# до **4/4 точно** при той же latency 50-71 с (см. ЖУРНАЛ_v1.6.md, v1.6.6).
# nomic-embed-text оставлен как fallback на случай, если bge-m3 не скачан
# (`ollama pull bge-m3`, ~600 МБ): просто не задавайте GEC_EMBED_MODEL и он
# подхватит значение RAG_EMBED_MODEL.
#
# Можно задать отдельно от RAG_EMBED_MODEL — выгодно когда:
#   • RAG_EMBED_MODEL=nomic-embed-text оптимален для длинных документов,
#     а для коротких пар правок точнее bge-m3.
#   • Хотите безопасно тестировать новый эмбеддер на GEC, не трогая RAG.
# Смена модели здесь — fingerprint кэша меняется → автоматическая
# переиндексация (~7-15 мин на CPU Broadwell для 927 пар, потом disk-cache).
# Доступные опции (требуется `ollama pull <model>`):
#   bge-m3               — 1024-dim, мультиязычный, на русском GEC лучший (default)
#   nomic-embed-text     — 768-dim, англо-русский, fallback / прежний дефолт v1.6.3
#   mxbai-embed-large    — 1024-dim, англо-ориентирован, медленнее
GEC_EMBED_MODEL=bge-m3

# Стратегия retrieval (с v1.6.7):
#   hybrid — RRF dense (cosine, bge-m3) + sparse (BM25) — дефолт.
#            На длинных официальных текстах dense часто промахивается,
#            потому что предметная лексика («КС-2», «государственный
#            контракт», «млн рублей») доминирует над грамматическим
#            сигналом. BM25 ловит редкие словоформы напрямую («стоимостей»,
#            «выполненной», «не предусмотренной»), и фьюжн через RRF
#            (Reciprocal Rank Fusion, k=60) выдвигает релевантные пары
#            в топ. См. Sorokin & Nasyrova (BEA 2025), Tang et al. (2024),
#            а также tim-ponomarev/hybrid-rag (production legaltech 2026).
#            Latency-impact: +5-15 мс/запрос (BM25-индекс в RAM, ~2-5 МБ).
#   dense  — pure cosine, поведение v1.6.6 (откат, если на каком-то корпусе
#            hybrid вдруг хуже).
#   sparse — pure BM25, для ablation-тестов.
GEC_RETRIEVAL_MODE=hybrid

# v1.7: Токенизатор для sparse-половины hybrid retrieval (BM25).
#   word    — токены = словоформы (поведение v1.6).
#   trigram — char-trigram-токенизация (повышает recall на
#             морфологически близких парах: «стоимостей» ↔ «стоимости»
#             — общие триграммы «$ст», «сто», «тои», ...).
#   both    — параллельные word+trigram индексы, скоры суммируются.
# Дефолт `both` (рекомендуется): word ловит точные совпадения цитат,
# trigram — морфологические близости. RAM-overhead ~5-10 МБ для 894
# пар, latency на построении +30-60 мс при старте, на запросе
# пренебрежимо. Установите `word` для отката к v1.6 поведению, если
# подозреваете регрессию.
GEC_BM25_TOKENIZER=both

# ─── Логирование ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# ─── Аудит запросов ───────────────────────────────────────────
AUDIT_ENABLED=true
AUDIT_DB=logs/audit.sqlite
AUDIT_REDACT_TEXT=false
