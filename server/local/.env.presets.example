# Select exactly one stack and restart ai-suggester.service.
# After the one-time installer has been run, operational switching is only:
#   LLM_PRESET=<A|C|D|E|F|G>
# followed by a normal service restart. No per-preset pip install is needed.
LLM_PRESET=A

# A — T-lite baseline
# LLM_PRESET=A

# C — Hybrid T-lite + compact surface GEC
# LLM_PRESET=C
# The one-time installer caches the secondary model as well.

# D — Qwen3.5-4B + SyntErr→LORuGEC LoRA
# LLM_PRESET=D
# Optional overrides:
# D_BASE_MODEL=Qwen/Qwen3.5-4B
# D_ADAPTER=synterr-nlp/bea2026-gec-adapters
# D_ADAPTER_SUBFOLDER=v4_qwen35_4b_lorugec

# E — local edit/tagger backend
# LLM_PRESET=E

# F — Spell-Corrector-RU-4B
# LLM_PRESET=F
# Optional override:
# F_MODEL=melsmm/Spell-Corrector-RU-4B

# G — local edit/tagger + T-lite verifier
# LLM_PRESET=G
# Optional overrides:
# G_VERIFIER_MODEL=t-tech/T-lite-it-2.1:q4_K_M
# G_VERIFIER_TIMEOUT=90

# Common runtime
OLLAMA_URL=http://localhost:11434
NUM_THREADS=28
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_TIMEOUT=300
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# Optional HF runtime tuning for D/F
# EXPERIMENTAL_DEVICE_MAP=auto
# EXPERIMENTAL_DTYPE=auto
# EXPERIMENTAL_GENERATION_WARMUP=false

# DecisionEngine
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=40
DECISION_MAX_BEFORE_CHARS=180

# Deterministic safety layers
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=true
USER_DICT_ENABLED=true
LANGUAGETOOL_ENABLED=false
RAG_ENABLED=false
SAGE_VALIDATOR_ENABLED=false

# C only
SECONDARY_GEC_ENABLED=false
SECONDARY_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
SECONDARY_GEC_TIMEOUT=90
SECONDARY_GEC_KEEP_ALIVE=5m
SECONDARY_GEC_MAX_EDITS=4
