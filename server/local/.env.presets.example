# Select exactly one stack and restart ai-suggester.service.
# A/C are the two existing production-capable stacks.
# D-G are experimental and require a separate OpenAI-compatible inference backend
# at EXPERIMENTAL_GEC_URL; see server/local/README.md.
LLM_PRESET=A

# A — T-lite baseline
# MODEL_NAME=t-tech/T-lite-it-2.1:q4_K_M

# C — Hybrid T-lite + compact surface GEC
# Primary: T-lite
# Secondary: hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
# MODEL_NAME=t-tech/T-lite-it-2.1:q4_K_M
# SECONDARY_GEC_ENABLED=true
# SECONDARY_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0

# D — Qwen3.5-4B + SyntErr→LORuGEC LoRA
# Requires a runtime serving the merged/adapted model via /v1/chat/completions.
# LLM_PRESET=D
# EXPERIMENTAL_GEC_URL=http://127.0.0.1:1234
# EXPERIMENTAL_MODEL=Qwen3.5-4B-SyntErr-LORuGEC

# E — Russian GEC sequence tagger (edit-based)
# Requires an inference wrapper that exposes structured GEC edits over /v1/chat/completions.
# LLM_PRESET=E
# EXPERIMENTAL_GEC_URL=http://127.0.0.1:8101
# EXPERIMENTAL_MODEL=RussianGEC_SeqTagger

# F — Spell-Corrector-RU-4B
# Intended as a spelling/punctuation/case surface layer, not a replacement for grammar GEC.
# Requires an OpenAI-compatible server.
# LLM_PRESET=F
# EXPERIMENTAL_GEC_URL=http://127.0.0.1:1234
# EXPERIMENTAL_MODEL=melsmm/Spell-Corrector-RU-4B

# G — Russian GEC sequence tagger + T-lite verifier
# Requires the tagger endpoint; T-lite remains local in the production server.
# The verifier stage is the next implementation step after tagger deployment.
# LLM_PRESET=G
# EXPERIMENTAL_GEC_URL=http://127.0.0.1:8101
# EXPERIMENTAL_MODEL=RussianGEC_SeqTagger

# Optional external model endpoint for D-G.
EXPERIMENTAL_GEC_URL=
EXPERIMENTAL_MODEL=

# Common runtime
OLLAMA_URL=http://localhost:11434
NUM_THREADS=28
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_TIMEOUT=300
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# DecisionEngine
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=40
DECISION_MAX_BEFORE_CHARS=180

# Existing deterministic safety layers
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=true
USER_DICT_ENABLED=true
LANGUAGETOOL_ENABLED=false
RAG_ENABLED=false
SAGE_VALIDATOR_ENABLED=false

# C only
SECONDARY_GEC_ENABLED=false
SECONDARY_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
SECONDARY_GEC_TIMEOUT=90
SECONDARY_GEC_KEEP_ALIVE=5m
SECONDARY_GEC_MAX_EDITS=4
