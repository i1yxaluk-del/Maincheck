# One of exactly three supported stacks. Restart ai-suggester.service after changes.
# A = production, F/G = experimental.
LLM_PRESET=A

# --- A: production ---
# T-lite-it-2.1 via local Ollama. Structured edit JSON; no full-text rewrite.

# --- F: experimental ---
# melsmm/Spell-Corrector-RU-4B via Transformers.
# Full-text output is admitted only through the surface/morphology gate.
# F_MODEL=melsmm/Spell-Corrector-RU-4B

# --- G: experimental ---
# Local MorphDetector candidates + T-lite verifier.
# G never asks the LLM to rewrite the whole paragraph.
# G_VERIFIER_MODEL=t-tech/T-lite-it-2.1:q4_K_M
# G_VERIFIER_TIMEOUT=90

# Common runtime
OLLAMA_URL=http://localhost:11434
NUM_THREADS=28
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=384
OLLAMA_TIMEOUT=120
OLLAMA_WARMUP=true
OLLAMA_KEEP_ALIVE=24h
OLLAMA_TEMPERATURE=0

# DecisionEngine safety
DECISION_MIN_CONFIDENCE=0.60
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120

# Deterministic components
MORPH_DETECTOR_ENABLED=true
USER_DICT_ENABLED=true
AUDIT_ENABLED=true

# F runtime
# EXPERIMENTAL_DEVICE_MAP=auto
