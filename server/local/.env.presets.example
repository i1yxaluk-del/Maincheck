# Select exactly one production experiment stack and restart ai-suggester.
# A = T-lite baseline (known good on Russian official-business GEC)
# B = Qwen3.5-4B + DecisionEngine (experimental)
# C = Hybrid: T-lite primary + compact surface GEC (experimental)
LLM_PRESET=A

# A — T-lite baseline
# MODEL_NAME=t-tech/T-lite-it-2.1:q4_K_M

# B — Qwen3.5-4B + structured DecisionEngine
# MODEL_NAME=qwen3.5:4b

# C — Hybrid surface stack
# Primary: T-lite
# Secondary: Loqira Qwen3.5-0.8B GEC GGUF Q4_0
# The secondary model is NOT downloaded by systemd automatically.
# One-time install on the production host:
#   ollama pull hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
# MODEL_NAME=t-tech/T-lite-it-2.1:q4_K_M
# SECONDARY_GEC_ENABLED=true
# SECONDARY_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0

# Common runtime
OLLAMA_URL=http://localhost:11434
NUM_THREADS=28
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT=300
OLLAMA_WARMUP=true
OLLAMA_WARMUP_TIMEOUT=300
OLLAMA_KEEP_ALIVE=24h
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0

# DecisionEngine
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=40
DECISION_MAX_BEFORE_CHARS=180

# Existing deterministic safety layers
MORPH_FILTER_ENABLED=true
MORPH_DETECTOR_ENABLED=true
USER_DICT_ENABLED=true
LANGUAGETOOL_ENABLED=false
RAG_ENABLED=false
SAGE_VALIDATOR_ENABLED=false

# Hybrid stack: enabled automatically only for preset C.
SECONDARY_GEC_ENABLED=false
SECONDARY_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
SECONDARY_GEC_TIMEOUT=90
SECONDARY_GEC_KEEP_ALIVE=5m
SECONDARY_GEC_MAX_EDITS=4
