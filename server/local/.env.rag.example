RAG_ENABLED=true
RAG_DOCUMENTS_DIR=/home/service/llama/RAG/documents
RAG_STORE_DIR=/home/service/llama/RAG/state
RAG_EMBEDDER=ollama
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_BATCH=2
RAG_EMBED_RETRIES=3
RAG_CHUNK_CHARS=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=6
RAG_WORKER_INTERVAL=30
RAG_SETTLE_SECONDS=10
# false: удалённый файл получает missing и исключается из поиска, но остаётся для аудита.
RAG_AUTO_PRUNE=false
# Если soffice не находится автоматически:
# RAG_SOFFICE_PATH=/usr/lib/libreoffice/program/soffice
