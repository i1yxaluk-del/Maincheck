[Unit]
Description=Maincheck v20 llama.cpp backend
After=network.target

[Service]
Type=simple
User=service
EnvironmentFile=/home/service/llama/server/local/.env.v20
ExecStart=/home/service/llama/vendor/llama.cpp/build/bin/llama-server --model ${V20_LLAMACPP_MODEL} --alias local-gec --host 127.0.0.1 --port 8091 --ctx-size 4096 --threads ${V20_LLAMA_THREADS} --threads-batch ${V20_LLAMA_THREADS} --numa distribute --parallel 1
Restart=on-failure
RestartSec=3
MemoryMax=24G

[Install]
WantedBy=multi-user.target
