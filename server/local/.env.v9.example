# v9 «точность прежде всего»: детерминированная морфология → специалисты → rescue.
# Файл описывает только локальный стек (server/local). Полный перечень
# переменных всех версий — в .env.example.
LLM_PRESET=A

# A: детерминированные правила + SAGE + Qwen3.5 GEC, rescue T-lite при нулевом результате
# B: то же, rescue GigaChat
# X: быстрый локальный путь без rescue (работает и без Ollama)
# Y: максимальная полнота, оба rescue

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_WARMUP=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16
HYBRID_LLM_TIMEOUT=30
HYBRID_NUM_CTX=3072
HYBRID_NUM_PREDICT=384

# ---------------------------------------------------------------------------
# Детерминированные стадии (работают без сети и без моделей)
# ---------------------------------------------------------------------------
# Согласование в именной группе через унификацию признаков.
RULE_AGREEMENT_ENABLED=true
# Согласование краткого сказуемого с подлежащим («принято меры»).
RULE_PREDICATIVE_ENABLED=true
# Опечатки, доказуемые словарём OpenCorpora.
DICT_SPELLCHECK_ENABLED=true
DICT_SPELLCHECK_MIN_LENGTH=5
DICT_SPELLCHECK_MAX_LENGTH=24
DICT_SPELLCHECK_CONFIDENCE=0.93

# ---------------------------------------------------------------------------
# Специалист по орфографии и пунктуации (~95M, transformers)
# ---------------------------------------------------------------------------
SAGE_CORRECTOR_ENABLED=true
SAGE_CORRECTOR_MODEL=ai-forever/sage-fredt5-distilled-95m
SAGE_CORRECTOR_MAX_NEW_TOKENS=192
SAGE_CORRECTOR_MAX_INPUT_TOKENS=384
SAGE_CORRECTOR_NUM_BEAMS=1
# На 32-ядерном сервере два потока были узким местом (1.2-2.7 с на фрагмент).
SAGE_CORRECTOR_THREADS=8
SAGE_CORRECTOR_MAX_BATCH=8
# int8 — динамическая квантизация nn.Linear, кратное ускорение на Broadwell.
SAGE_QUANTIZE=none

# ---------------------------------------------------------------------------
# Русский GEC-специалист в уже запущенном демоне Ollama
# ---------------------------------------------------------------------------
OLLAMA_GEC_ENABLED=true
OLLAMA_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
OLLAMA_GEC_TIMEOUT=30
OLLAMA_GEC_NUM_CTX=2048
OLLAMA_GEC_NUM_PREDICT=256
OLLAMA_GEC_NUM_THREAD=16
# Few-shot пары из shared/gec_seed подаются как история диалога.
OLLAMA_GEC_FEW_SHOT=3

# ---------------------------------------------------------------------------
# Пунктуация и типографика: локальный LanguageTool (офлайн, порт 8081)
# ---------------------------------------------------------------------------
LANGUAGETOOL_ENABLED=false
LANGUAGETOOL_URL=http://127.0.0.1:8081
LANGUAGETOOL_LANGUAGE=ru-RU
LANGUAGETOOL_TIMEOUT=10
# GRAMMAR и TYPOS закрыты детерминированными стадиями сервера.
LANGUAGETOOL_ENABLED_CATEGORIES=PUNCTUATION,TYPOGRAPHY
LANGUAGETOOL_DISABLED_CATEGORIES=
LANGUAGETOOL_DISABLED_RULES=
LANGUAGETOOL_CONFIDENCE=0.90
LANGUAGETOOL_MAX_MATCHES=12

# ---------------------------------------------------------------------------
# Маршрутизация и арбитраж
# ---------------------------------------------------------------------------
# Сегментация: модели работают по предложениям.
LOCAL_MAX_SENTENCES=12
# auto — rescue только если ничего не подтверждено; always / never для отладки.
LOCAL_RESCUE_MODE=auto
LOCAL_RESCUE_MIN_CANDIDATES=1
# Инфлективная правка от одной модели требует подтверждения.
ARBITER_MIN_VOTES_INFLECTION=2
ARBITER_CORROBORATION_BONUS=0.10
ARBITER_SOLO_PENALTY=0.25
# Фильтр галлюцинаций генеративных стадий.
GENERATIVE_GUARD_ENABLED=true

# ---------------------------------------------------------------------------
# Решающий движок
# ---------------------------------------------------------------------------
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=12
DECISION_MAX_BEFORE_CHARS=120
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
