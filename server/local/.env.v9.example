# Unified local configuration: choose A, B, X, Y or Z.
LLM_PRESET=A
# A: deterministic + SAGE + Qwen3.5 GEC + T-lite rescue
# B: deterministic + SAGE + Qwen3.5 GEC + GigaChat rescue
# X: deterministic + SAGE + Qwen3.5 GEC, no rescue
# Y: deterministic + SAGE + Qwen3.5 GEC + both rescues
# Z: fast punctuation ensemble; DeepSeek-R1 only as fallback

OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=30
OLLAMA_WARMUP=true
OLLAMA_KEEP_ALIVE=30m
NUM_THREADS=16
HYBRID_LLM_TIMEOUT=30
HYBRID_NUM_CTX=3072
HYBRID_NUM_PREDICT=384

RULE_AGREEMENT_ENABLED=true
RULE_PREDICATIVE_ENABLED=true
DICT_SPELLCHECK_ENABLED=true
DICT_SPELLCHECK_MIN_LENGTH=4
DICT_SPELLCHECK_MAX_LENGTH=28
DICT_SPELLCHECK_CONFIDENCE=0.93

SAGE_CORRECTOR_ENABLED=true
SAGE_CORRECTOR_MODEL=ai-forever/sage-fredt5-distilled-95m
SAGE_CORRECTOR_MAX_NEW_TOKENS=192
SAGE_CORRECTOR_MAX_INPUT_TOKENS=384
SAGE_CORRECTOR_NUM_BEAMS=1
SAGE_CORRECTOR_THREADS=8
SAGE_CORRECTOR_MAX_BATCH=8
SAGE_QUANTIZE=none

# Dedicated Russian comma classifier, used by every preset.
RUPUNCT_ENABLED=true
RUPUNCT_MODEL=RUPunct/RUPunct_big
RUPUNCT_THREADS=8
RUPUNCT_MAX_WORDS=220
RUPUNCT_ADD_THRESHOLD=0.88
RUPUNCT_REMOVE_THRESHOLD=0.96

OLLAMA_GEC_ENABLED=true
OLLAMA_GEC_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
OLLAMA_GEC_TIMEOUT=30
OLLAMA_GEC_NUM_CTX=2048
OLLAMA_GEC_NUM_PREDICT=256
OLLAMA_GEC_NUM_THREAD=16
OLLAMA_GEC_FEW_SHOT=3

REASONING_CASCADE_ENABLED=true
REASONING_MODE=fallback
REASONING_MODEL=deepseek-r1:7b-qwen-distill-q4_K_M
REASONING_EXTRACTOR_MODEL=hf.co/loqira/Qwen3.5-0.8B-GEC-KAZ-RUS-ENG:Q4_0
REASONING_TIMEOUT=60
REASONING_EXTRACT_TIMEOUT=25
REASONING_NUM_CTX=3072
REASONING_NUM_PREDICT=512
REASONING_NUM_THREADS=16
REASONING_MAX_SENTENCES=4

LANGUAGETOOL_ENABLED=true
LANGUAGETOOL_URL=http://127.0.0.1:8081
LANGUAGETOOL_LANGUAGE=ru-RU
LANGUAGETOOL_TIMEOUT=5
LANGUAGETOOL_ENABLED_CATEGORIES=PUNCTUATION,TYPOGRAPHY,TYPOS,GRAMMAR
LANGUAGETOOL_DISABLED_CATEGORIES=
LANGUAGETOOL_DISABLED_RULES=
LANGUAGETOOL_CONFIDENCE=0.90
LANGUAGETOOL_MAX_MATCHES=20

LOCAL_MAX_SENTENCES=12
LOCAL_RESCUE_MODE=auto
LOCAL_RESCUE_MIN_CANDIDATES=1
ARBITER_MIN_VOTES_INFLECTION=2
ARBITER_CORROBORATION_BONUS=0.10
ARBITER_SOLO_PENALTY=0.25
GENERATIVE_GUARD_ENABLED=true
DECISION_MIN_CONFIDENCE=0.55
DECISION_MAX_CHANGES=20
DECISION_MAX_BEFORE_CHARS=160
USER_DICT_ENABLED=true
AUDIT_ENABLED=true
