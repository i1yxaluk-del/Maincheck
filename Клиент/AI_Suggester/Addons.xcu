<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons"
                    oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeToolBar">
      <node oor:name="ai.suggester.toolbar" oor:op="replace">
        <prop oor:name="ResourceURL" oor:type="xs:string">
          <value>private:resource/toolbar/ai.suggester.toolbar</value>
        </prop>
        <node oor:name="m001" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.sun.star.script:ai_macro.Main.AISuggestSelection?language=Basic&amp;location=application</value>
          </prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value/></prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="ru">AI: Улучшить текст</value>
            <value xml:lang="en">AI: Suggest</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="m002" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.sun.star.script:ai_macro.Dict.AIDictAddSelection?language=Basic&amp;location=application</value>
          </prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value/></prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="ru">AI: В словарь</value>
            <value xml:lang="en">AI: Add to dict</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="m003" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.sun.star.script:ai_macro.Dict.AIDictManage?language=Basic&amp;location=application</value>
          </prop>
          <prop oor:name="ImageIdentifier" oor:type="xs:string"><value/></prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="ru">AI: Словарь</value>
            <value xml:lang="en">AI: Dictionary</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
<!--
  На панели инструментов сотрудника показываются ТРИ кнопки:
    • «AI: Улучшить текст» (m001) — основной макрос Main.AISuggestSelection.
    • «AI: В словарь»      (m002) — Dict.AIDictAddSelection: быстрое добавление
      выделенного фрагмента (аббревиатура / служебный термин / исключение)
      в пользовательский словарь на сервере.
    • «AI: Словарь»        (m003, v1.8.3) — Dict.AIDictManage: диалог со
      списком всех слов и кнопками «Удалить выделенные» / «Добавить новое» /
      «Закрыть». Используется для просмотра словаря и пакетного удаления.

  Сервер хранит словарь в data/user_dict.json и инжектит его в SYSTEM_PROMPT
  при каждом /suggest, чтобы модель считала эти слова корректными.

  Диагностический макрос Health.AICheckServer и legacy-макросы
  Dict.AIDictListWords / Dict.AIDictRemoveWord (на InputBox) остаются
  зарегистрированными в script.xlb и доступны через «Сервис → Макросы»,
  но не вынесены на панель — основной поток управления словарём теперь
  через «AI: Словарь».
-->

