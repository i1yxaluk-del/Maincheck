<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Dict" script:language="StarBasic"><![CDATA[
' ═══════════════════════════════════════════════════════════════════════════
'  ПОЛЬЗОВАТЕЛЬСКИЙ СЛОВАРЬ (v1.8b)
'
'  Сотрудник выделяет аббревиатуру/служебное слово/исключение, нажимает
'  кнопку «AI: В словарь», и слово отправляется на сервер через POST
'  /dict/add. Сервер хранит словарь в data/user_dict.json и при каждом
'  /suggest:
'    1) инжектит список в SYSTEM_PROMPT («считать корректными: ...»);
'    2) фильтрует CHANGES, где before/after содержат слово из словаря;
'    3) передаёт whitelist в morph-детектор, чтобы тот не флагал OOV.
'
'  Доступны макросы:
'    • Dict.AIDictAddSelection() — добавить выделенное слово (на панели, m002).
'    • Dict.AIDictManage()       — диалог управления словарём (на панели, m003,
'                                  v1.8.3): ListBox + кнопки «Удалить»/
'                                  «Добавить»/«Закрыть».
'    • Dict.AIDictListWords()    — короткий список (MsgBox) для совместимости.
'    • Dict.AIDictRemoveWord()   — удалить по InputBox-вводу, для совместимости.
'
'  Адрес /dict берётся из DictBaseUrl() (выводится из Settings.GetServerList).
' ═══════════════════════════════════════════════════════════════════════════

' ═══════════════════════════════════════════════════
'  ДОБАВИТЬ ВЫДЕЛЕННЫЙ ТЕРМИН В СЛОВАРЬ
' ═══════════════════════════════════════════════════
Sub AIDictAddSelection()
    On Error GoTo ErrorHandler

    Dim oDoc  As Object : oDoc  = ThisComponent
    Dim oSels As Object : oSels = oDoc.getCurrentSelection()
    If IsNull(oSels) Or IsEmpty(oSels) Then
        MsgBox "Выделите слово (аббревиатуру/термин), которое нужно добавить в словарь.", _
               64, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim oSel As Object : oSel = oSels.getByIndex(0)
    Dim sWord As String : sWord = Trim(oSel.getString())
    If sWord = "" Then
        MsgBox "Выделенный фрагмент пустой.", 64, "AI Suggester — Словарь"
        Exit Sub
    End If

    ' Валидация на стороне клиента: одно слово без пробелов/переносов
    If InStr(sWord, " ") > 0 Or InStr(sWord, Chr(10)) > 0 Or InStr(sWord, Chr(13)) > 0 Then
        MsgBox "В словарь добавляется ОДНО слово. Выделено: «" & sWord & "».", _
               48, "AI Suggester — Словарь"
        Exit Sub
    End If
    If Len(sWord) < 2 Or Len(sWord) > 64 Then
        MsgBox "Длина слова должна быть от 2 до 64 символов. Выделено " & _
               CStr(Len(sWord)) & " симв.: «" & sWord & "».", _
               48, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim sUrl As String : sUrl = DictAddUrl()
    If sUrl = "" Then
        MsgBox "Не настроен адрес сервера (Settings.GetServerList).", _
               16, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim sResp As String, sHttp As String
    If Not PostJson(sUrl, "{""word"":""" & EscapeJsonString(sWord) & """}", sResp, sHttp) Then
        MsgBox "Не удалось связаться с сервером:" & Chr(10) & sUrl & Chr(10) & _
               "HTTP: " & sHttp & Chr(10) & "Ответ: " & Left(sResp, 300), _
               16, "AI Suggester — Словарь"
        Exit Sub
    End If

    ' v1.8.2: sHttp может быть пустым из-за особенностей redirection
    ' в Shell (status-файл не всегда пишется до возврата). При этом сервер
    ' на /dict/* всегда возвращает JSON в sResp с полем "added" (200 или 4xx);
    ' если в ответе есть `"added":true|false` — связь была и HTTP был 200.
    ' См. аналогичный fallback в Main.xba (===CORRECTED=== маркер).
    Dim bOk As Boolean : bOk = (Left(sHttp, 1) = "2")
    If Not bOk And sHttp = "" And InStr(sResp, """added"":") > 0 Then bOk = True
    If bOk Then
        ' 200 OK: разбираем "added":true/false и "total":N
        Dim sMsg As String
        If InStr(sResp, """added"":true") > 0 Then
            sMsg = "Слово «" & sWord & "» добавлено в словарь." & Chr(10) & Chr(10) & _
                   "Всего слов: " & ExtractTotal(sResp) & Chr(10) & Chr(10) & _
                   "При следующих проверках сервер будет считать его корректным."
        Else
            sMsg = "Слово «" & sWord & "» уже было в словаре." & Chr(10) & Chr(10) & _
                   "Всего слов: " & ExtractTotal(sResp)
        End If
        MsgBox sMsg, 64, "AI Suggester — Словарь"
    Else
        ' 400 (валидация), 503 (отключён), 500 (внутренняя)
        Dim sHttpShown As String : sHttpShown = sHttp
        If sHttpShown = "" Then sHttpShown = "?"
        MsgBox "Сервер отверг запрос (HTTP " & sHttpShown & "):" & Chr(10) & _
               Left(sResp, 400), 48, "AI Suggester — Словарь"
    End If
    Exit Sub

ErrorHandler:
    MsgBox "Внутренняя ошибка (#" & Err & "): " & Error, 16, "AI Suggester — Словарь"
End Sub

' ═══════════════════════════════════════════════════
'  ПОКАЗАТЬ ТЕКУЩИЙ СПИСОК СЛОВАРЯ
' ═══════════════════════════════════════════════════
Sub AIDictListWords()
    On Error GoTo ErrorHandler

    Dim sUrl As String : sUrl = DictListUrl()
    If sUrl = "" Then
        MsgBox "Не настроен адрес сервера (Settings.GetServerList).", _
               16, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim sResp As String, sHttp As String
    If Not GetUrl(sUrl, sResp, sHttp) Then
        MsgBox "Не удалось связаться с сервером:" & Chr(10) & sUrl & Chr(10) & _
               "HTTP: " & sHttp, 16, "AI Suggester — Словарь"
        Exit Sub
    End If

    ' v1.8.2: пустой sHttp при наличии "words" в теле — считаем 200 OK
    Dim bOkL As Boolean : bOkL = (Left(sHttp, 1) = "2")
    If Not bOkL And sHttp = "" And InStr(sResp, """words""") > 0 Then bOkL = True
    If Not bOkL Then
        Dim sHttpShownL As String : sHttpShownL = sHttp
        If sHttpShownL = "" Then sHttpShownL = "?"
        MsgBox "Сервер вернул HTTP " & sHttpShownL & ":" & Chr(10) & Left(sResp, 400), _
               48, "AI Suggester — Словарь"
        Exit Sub
    End If

    ' Парсим "words": ["a", "b", ...] в одну строку с разделителем |. Причина отказа
    ' от нативного массива: StarBasic-компилятор не всегда принимает
    ' возврат типизированного массива из Function и отрицательные ReDim-границы
    ' (-1 To -1) — компилятор падает с «Неожиданный символ: (.». Поэтому возвращаем
    ' плоскую строку, потом Split() на стороне вызывающего.
    Dim sJoined As String : sJoined = ExtractWordsJoined(sResp)
    Dim aWords() As String
    Dim nTotal As Integer : nTotal = 0
    If sJoined <> "" Then
        aWords = Split(sJoined, Chr(10))
        nTotal = UBound(aWords) + 1
    End If

    Dim sMsg As String
    If nTotal <= 0 Then
        sMsg = "Словарь пуст." & Chr(10) & Chr(10) & _
               "Чтобы добавить слово: выделите его в тексте и нажмите кнопку «AI: В словарь»."
    Else
        sMsg = "В словаре " & CStr(nTotal) & " слов(а):" & Chr(10) & Chr(10)
        Dim i As Integer
        For i = 0 To UBound(aWords)
            sMsg = sMsg & "  • " & aWords(i) & Chr(10)
            If i >= 60 Then
                sMsg = sMsg & "  … и ещё " & CStr(UBound(aWords) - i) & Chr(10)
                Exit For
            End If
        Next i
    End If
    MsgBox sMsg, 64, "AI Suggester — Словарь"
    Exit Sub

ErrorHandler:
    MsgBox "Внутренняя ошибка (#" & Err & "): " & Error, 16, "AI Suggester — Словарь"
End Sub

' ═══════════════════════════════════════════════════
'  УДАЛИТЬ СЛОВО ИЗ СЛОВАРЯ
' ═══════════════════════════════════════════════════
Sub AIDictRemoveWord()
    On Error GoTo ErrorHandler

    Dim sWord As String
    sWord = Trim(InputBox("Введите слово для удаления из словаря:", _
                          "AI Suggester — Словарь", ""))
    If sWord = "" Then Exit Sub

    Dim sUrl As String : sUrl = DictRemoveUrl()
    If sUrl = "" Then
        MsgBox "Не настроен адрес сервера (Settings.GetServerList).", _
               16, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim sResp As String, sHttp As String
    If Not PostJson(sUrl, "{""word"":""" & EscapeJsonString(sWord) & """}", sResp, sHttp) Then
        MsgBox "Не удалось связаться с сервером:" & Chr(10) & sUrl & Chr(10) & _
               "HTTP: " & sHttp & Chr(10) & "Ответ: " & Left(sResp, 300), _
               16, "AI Suggester — Словарь"
        Exit Sub
    End If

    ' v1.8.2: пустой sHttp при наличии "removed" в теле — считаем 200 OK
    Dim bOkR As Boolean : bOkR = (Left(sHttp, 1) = "2")
    If Not bOkR And sHttp = "" And InStr(sResp, """removed"":") > 0 Then bOkR = True
    If bOkR Then
        Dim sMsg As String
        If InStr(sResp, """removed"":true") > 0 Then
            sMsg = "Слово «" & sWord & "» удалено из словаря." & Chr(10) & Chr(10) & _
                   "Всего слов: " & ExtractTotal(sResp)
        Else
            sMsg = "Слова «" & sWord & "» не было в словаре." & Chr(10) & Chr(10) & _
                   "Всего слов: " & ExtractTotal(sResp)
        End If
        MsgBox sMsg, 64, "AI Suggester — Словарь"
    Else
        Dim sHttpShownR As String : sHttpShownR = sHttp
        If sHttpShownR = "" Then sHttpShownR = "?"
        MsgBox "Сервер отверг запрос (HTTP " & sHttpShownR & "):" & Chr(10) & _
               Left(sResp, 400), 48, "AI Suggester — Словарь"
    End If
    Exit Sub

ErrorHandler:
    MsgBox "Внутренняя ошибка (#" & Err & "): " & Error, 16, "AI Suggester — Словарь"
End Sub


' ═══════════════════════════════════════════════════════════════════════════
'  УПРАВЛЕНИЕ СЛОВАРЁМ — ДИАЛОГ (v1.8.3)
' ═══════════════════════════════════════════════════════════════════════════
'  Один экран: список слов + кнопки «Удалить выделенные» / «Добавить
'  новое» / «Закрыть».  После каждого изменения диалог переоткрывается
'  с актуальным списком от сервера. Это удобнее, чем три отдельных макроса
'  (AIDictListWords / AIDictAddSelection / AIDictRemoveWord) из v1.8b,
'  которые остаются для совместимости и REST-первого workflow.
'
'  Диалог строится программно (UnoControlDialogModel), без .xdl-файла,
'  чтобы не плодить парные xdl/xlb-файлы в OXT.
' ═══════════════════════════════════════════════════════════════════════════

' Состояние диалога во время вызова. Записывается из listener'а кнопки
' «Добавить» (см. AIDictDlg_BtnAdd_actionPerformed), читается обратно
' в AIDictManage(). g_DictDlg_Dialog нужен listener'у, чтобы вызвать
' endExecute() и закрыть диалог.
Private g_DictDlg_Dialog As Object
Private g_DictDlg_Action As String

Sub AIDictManage()
    On Error GoTo ErrorHandler

    Do
        Dim sError As String : sError = ""
        Dim sJoined As String : sJoined = LoadDictWordsJoined(sError)
        If sError <> "" Then
            MsgBox sError, 48, "AI Suggester — Словарь"
            Exit Sub
        End If

        g_DictDlg_Action = "close"
        Dim aSelected() As String
        Dim nSelCount As Integer : nSelCount = 0
        Call AIDictManage_ShowDialog(sJoined, aSelected, nSelCount)

        Select Case g_DictDlg_Action
            Case "add"
                Call AIDictManage_DoAdd()
            Case "delete"
                Call AIDictManage_DoDelete(aSelected, nSelCount)
            Case Else
                Exit Do
        End Select
    Loop
    Exit Sub

ErrorHandler:
    MsgBox "Внутренняя ошибка (#" & Err & "): " & Error, 16, "AI Suggester — Словарь"
End Sub

' Загружает /dict/list и возвращает слова через Chr(10). При ошибке
' пишет понятное сообщение в sError (caller покажет MsgBox).
Function LoadDictWordsJoined(ByRef sError As String) As String
    LoadDictWordsJoined = ""
    sError = ""

    Dim sUrl As String : sUrl = DictListUrl()
    If sUrl = "" Then
        sError = "Не настроен адрес сервера (Settings.GetServerList)."
        Exit Function
    End If

    Dim sResp As String, sHttp As String
    If Not GetUrl(sUrl, sResp, sHttp) Then
        sError = "Не удалось связаться с сервером:" & Chr(10) & sUrl & Chr(10) & _
                 "HTTP: " & sHttp
        Exit Function
    End If

    ' v1.8.2 fallback: пустой sHttp при наличии "words" — считаем 200 OK
    Dim bOk As Boolean : bOk = (Left(sHttp, 1) = "2")
    If Not bOk And sHttp = "" And InStr(sResp, """words""") > 0 Then bOk = True
    If Not bOk Then
        Dim sHttpShown As String : sHttpShown = sHttp
        If sHttpShown = "" Then sHttpShown = "?"
        sError = "Сервер вернул HTTP " & sHttpShown & ":" & Chr(10) & Left(sResp, 400)
        Exit Function
    End If

    LoadDictWordsJoined = ExtractWordsJoined(sResp)
End Function

' Строит диалог программно. По выходу заполняет aSelected/nSelCount
' (выделенные слова, если пользователь нажал «Удалить»). Глобальный
' g_DictDlg_Action содержит "close" | "add" | "delete".
Sub AIDictManage_ShowDialog(sJoined As String, ByRef aSelected() As String, _
                            ByRef nSelCount As Integer)
    nSelCount = 0

    ' Разбираем JSON-список слов (joined через Chr(10), см. ExtractWordsJoined)
    Dim aWords() As String
    Dim nCount As Integer : nCount = 0
    If sJoined <> "" Then
        aWords = Split(sJoined, Chr(10))
        nCount = UBound(aWords) + 1
    End If

    ' === Dialog model ===
    Dim oDlgModel As Object
    oDlgModel = createUnoService("com.sun.star.awt.UnoControlDialogModel")
    oDlgModel.PositionX = 100
    oDlgModel.PositionY = 100
    oDlgModel.Width  = 220
    oDlgModel.Height = 180
    oDlgModel.Title  = "AI Suggester — Управление словарём"

    ' Header label
    Dim oLbl As Object
    oLbl = oDlgModel.createInstance("com.sun.star.awt.UnoControlFixedTextModel")
    oLbl.Name      = "lblHdr"
    oLbl.PositionX = 5
    oLbl.PositionY = 5
    oLbl.Width     = 210
    oLbl.Height    = 10
    If nCount = 0 Then
        oLbl.Label = "Словарь пуст. Нажмите «Добавить новое...» чтобы пополнить."
    Else
        oLbl.Label = "Слов в словаре: " & CStr(nCount) & ". Выделите для удаления:"
    End If
    oDlgModel.insertByName("lblHdr", oLbl)

    ' ListBox (multi-select)
    Dim oLst As Object
    oLst = oDlgModel.createInstance("com.sun.star.awt.UnoControlListBoxModel")
    oLst.Name           = "lstWords"
    oLst.PositionX      = 5
    oLst.PositionY      = 18
    oLst.Width          = 210
    oLst.Height         = 130
    oLst.MultiSelection = True
    If nCount > 0 Then oLst.StringItemList = aWords
    oDlgModel.insertByName("lstWords", oLst)

    ' Button: «Удалить выделенные» — OK (PushButtonType=1)
    Dim oBtnDel As Object
    oBtnDel = oDlgModel.createInstance("com.sun.star.awt.UnoControlButtonModel")
    oBtnDel.Name           = "btnDelete"
    oBtnDel.PositionX      = 5
    oBtnDel.PositionY      = 158
    oBtnDel.Width          = 80
    oBtnDel.Height         = 14
    oBtnDel.Label          = "Удалить выделенные"
    oBtnDel.PushButtonType = 1
    If nCount = 0 Then oBtnDel.Enabled = False
    oDlgModel.insertByName("btnDelete", oBtnDel)

    ' Button: «Добавить новое...» — STANDARD (с listener'ом)
    Dim oBtnAdd As Object
    oBtnAdd = oDlgModel.createInstance("com.sun.star.awt.UnoControlButtonModel")
    oBtnAdd.Name           = "btnAdd"
    oBtnAdd.PositionX      = 88
    oBtnAdd.PositionY      = 158
    oBtnAdd.Width          = 80
    oBtnAdd.Height         = 14
    oBtnAdd.Label          = "Добавить новое..."
    oBtnAdd.PushButtonType = 0
    oDlgModel.insertByName("btnAdd", oBtnAdd)

    ' Button: «Закрыть» — CANCEL (PushButtonType=2)
    Dim oBtnCls As Object
    oBtnCls = oDlgModel.createInstance("com.sun.star.awt.UnoControlButtonModel")
    oBtnCls.Name           = "btnClose"
    oBtnCls.PositionX      = 171
    oBtnCls.PositionY      = 158
    oBtnCls.Width          = 44
    oBtnCls.Height         = 14
    oBtnCls.Label          = "Закрыть"
    oBtnCls.PushButtonType = 2
    oDlgModel.insertByName("btnClose", oBtnCls)

    ' === Dialog control ===
    Dim oDlg As Object
    oDlg = createUnoService("com.sun.star.awt.UnoControlDialog")
    oDlg.setModel(oDlgModel)

    ' createPeer обязателен ДО addActionListener (иначе getControl вернёт пустышку)
    Dim oToolkit As Object
    oToolkit = createUnoService("com.sun.star.awt.Toolkit")
    oDlg.createPeer(oToolkit, Null)

    ' Listener для «Добавить» — STANDARD-кнопка сама не закрывает диалог
    g_DictDlg_Dialog = oDlg
    Dim oListener As Object
    oListener = CreateUnoListener("AIDictDlg_BtnAdd_", "com.sun.star.awt.XActionListener")
    oDlg.getControl("btnAdd").addActionListener(oListener)

    ' execute() блокирующий: 1 = OK (Delete), 0 = CANCEL (Close или Add via endExecute)
    Dim nResult As Integer : nResult = oDlg.execute()

    ' Если listener успел поставить "add" — НЕ переписываем. Иначе:
    If g_DictDlg_Action <> "add" Then
        If nResult = 1 Then
            ' OK: читаем выделенные индексы
            Dim oListCtl As Object : oListCtl = oDlg.getControl("lstWords")
            Dim aSelPos
            aSelPos = oListCtl.getSelectedItemsPos()
            Dim n As Integer : n = UBound(aSelPos) + 1
            If n > 0 Then
                ReDim aSelected(n - 1)
                Dim i As Integer
                For i = 0 To n - 1
                    aSelected(i) = aWords(aSelPos(i))
                Next i
                nSelCount = n
                g_DictDlg_Action = "delete"
            Else
                ' Нечего удалять — просто закрываем
                g_DictDlg_Action = "close"
            End If
        Else
            g_DictDlg_Action = "close"
        End If
    End If

    oDlg.dispose()
    g_DictDlg_Dialog = Nothing
End Sub

' XActionListener для кнопки «Добавить новое...»:
'   Sub-имена должны быть `<Prefix><method>` (см. CreateUnoListener в docs).
'   actionPerformed — клик; disposing — обязательный no-op из XEventListener.
Sub AIDictDlg_BtnAdd_actionPerformed(oEvt As Object)
    g_DictDlg_Action = "add"
    If Not IsNull(g_DictDlg_Dialog) Then g_DictDlg_Dialog.endExecute()
End Sub

Sub AIDictDlg_BtnAdd_disposing(oEvt As Object)
    ' no-op
End Sub

' Запрашивает у пользователя новое слово через InputBox и шлёт /dict/add.
' На успех сообщений не показывает (diff увидит при reopen диалога).
Sub AIDictManage_DoAdd()
    Dim sWord As String
    sWord = Trim(InputBox( _
        "Введите новое слово для добавления в словарь:" & Chr(10) & Chr(10) & _
        "Правила: одно слово, 2-64 символа, без пробелов.", _
        "AI Suggester — Словарь", ""))
    If sWord = "" Then Exit Sub

    If InStr(sWord, " ") > 0 Or InStr(sWord, Chr(10)) > 0 Or InStr(sWord, Chr(13)) > 0 Then
        MsgBox "В словарь добавляется ОДНО слово (без пробелов). Введено: «" & _
               sWord & "».", 48, "AI Suggester — Словарь"
        Exit Sub
    End If
    If Len(sWord) < 2 Or Len(sWord) > 64 Then
        MsgBox "Длина слова должна быть от 2 до 64 символов. Введено " & _
               CStr(Len(sWord)) & " симв.", 48, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim sUrl As String : sUrl = DictAddUrl()
    If sUrl = "" Then
        MsgBox "Не настроен адрес сервера.", 16, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim sResp As String, sHttp As String
    If Not PostJson(sUrl, "{""word"":""" & EscapeJsonString(sWord) & """}", sResp, sHttp) Then
        MsgBox "Не удалось связаться с сервером:" & Chr(10) & Left(sResp, 300), _
               16, "AI Suggester — Словарь"
        Exit Sub
    End If

    Dim bOk As Boolean : bOk = (Left(sHttp, 1) = "2")
    If Not bOk And sHttp = "" And InStr(sResp, """added"":") > 0 Then bOk = True
    If Not bOk Then
        Dim sHttpShown As String : sHttpShown = sHttp
        If sHttpShown = "" Then sHttpShown = "?"
        MsgBox "Сервер отверг запрос (HTTP " & sHttpShown & "):" & Chr(10) & _
               Left(sResp, 400), 48, "AI Suggester — Словарь"
    End If
End Sub

' Удаляет переданные слова через /dict/remove (по одному запросу на слово,
' /dict/remove не имеет batch-варианта). Показывает confirm перед удалением
' и summary с числом ошибок, если они были.
Sub AIDictManage_DoDelete(aWords() As String, nCount As Integer)
    If nCount <= 0 Then Exit Sub

    Dim sUrl As String : sUrl = DictRemoveUrl()
    If sUrl = "" Then
        MsgBox "Не настроен адрес сервера.", 16, "AI Suggester — Словарь"
        Exit Sub
    End If

    ' Confirm
    Dim sPreview As String : sPreview = ""
    Dim j As Integer
    For j = 0 To nCount - 1
        sPreview = sPreview & "  • " & aWords(j) & Chr(10)
        If j >= 10 Then
            sPreview = sPreview & "  … и ещё " & CStr(nCount - 1 - j) & Chr(10)
            Exit For
        End If
    Next j

    Dim nAns As Integer
    nAns = MsgBox("Удалить " & CStr(nCount) & " слов(а) из словаря?" & Chr(10) & _
                  Chr(10) & sPreview, 4 + 32, "AI Suggester — Словарь")
    If nAns <> 6 Then Exit Sub  ' 6 = Yes

    Dim nOk As Integer : nOk = 0
    Dim nFail As Integer : nFail = 0
    Dim sFirstErr As String : sFirstErr = ""
    Dim k As Integer
    For k = 0 To nCount - 1
        Dim sResp As String, sHttp As String
        If PostJson(sUrl, "{""word"":""" & EscapeJsonString(aWords(k)) & """}", _
                    sResp, sHttp) Then
            Dim bOk As Boolean : bOk = (Left(sHttp, 1) = "2")
            If Not bOk And sHttp = "" And InStr(sResp, """removed"":") > 0 Then bOk = True
            If bOk Then
                nOk = nOk + 1
            Else
                nFail = nFail + 1
                If sFirstErr = "" Then sFirstErr = aWords(k) & " (HTTP " & sHttp & ")"
            End If
        Else
            nFail = nFail + 1
            If sFirstErr = "" Then sFirstErr = aWords(k) & " (нет связи)"
        End If
    Next k

    If nFail > 0 Then
        MsgBox "Удалено: " & CStr(nOk) & ". Ошибок: " & CStr(nFail) & "." & _
               Chr(10) & "Первая ошибка: " & sFirstErr, _
               48, "AI Suggester — Словарь"
    End If
End Sub


' ═══════════════════════════════════════════════════
'  ВНУТРЕННИЕ ХЕЛПЕРЫ — URL-ы
' ═══════════════════════════════════════════════════
' Берём ПЕРВЫЙ из списка серверов (Settings.GetServerList "url1|url2"),
' меняем /suggest → /dict/add | /dict/list | /dict/remove.
Function DictBaseUrl() As String
    Dim sList As String : sList = Settings.GetServerList()
    If sList = "" Then DictBaseUrl = "" : Exit Function
    Dim aUrls() As String : aUrls = Split(sList, "|")
    DictBaseUrl = Trim(aUrls(0))
End Function

Function DictAddUrl() As String
    Dim s As String : s = DictBaseUrl()
    If s = "" Then DictAddUrl = "" : Exit Function
    DictAddUrl = Replace(s, "/suggest", "/dict/add")
End Function

Function DictListUrl() As String
    Dim s As String : s = DictBaseUrl()
    If s = "" Then DictListUrl = "" : Exit Function
    DictListUrl = Replace(s, "/suggest", "/dict/list")
End Function

Function DictRemoveUrl() As String
    Dim s As String : s = DictBaseUrl()
    If s = "" Then DictRemoveUrl = "" : Exit Function
    DictRemoveUrl = Replace(s, "/suggest", "/dict/remove")
End Function


' ═══════════════════════════════════════════════════
'  HTTP ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
' ═══════════════════════════════════════════════════
' POST JSON через curl. Возвращает True при успешном HTTP-ответе (любой 2xx).
' sResp получает тело ответа, sHttp — код (например "200" / "400" / "503").
Function PostJson(sUrl As String, sJson As String, ByRef sResp As String, _
                  ByRef sHttp As String) As Boolean
    PostJson = False
    sResp = "" : sHttp = ""

    Dim oPS As Object : oPS = CreateUnoService("com.sun.star.util.PathSettings")
    Dim sTmp As String : sTmp = ConvertFromURL(oPS.Temp)
    Dim sSep As String : sSep = IIf(GetGUIType() = 1, "\", "/")
    Dim sIn  As String : sIn  = sTmp & sSep & "ai_dict_in.json"
    Dim sOut As String : sOut = sTmp & sSep & "ai_dict_out.txt"
    Dim sSt  As String : sSt  = sTmp & sSep & "ai_dict_status.txt"

    Main.WriteUTF8 sIn, sJson
    If FileExists(sOut) Then Kill sOut
    If FileExists(sSt) Then Kill sSt

    Dim sCmd As String
    If GetGUIType() = 1 Then
        ' Windows: %% → одинарный % (см. комментарий в Main.xba про cmd.exe)
        sCmd = "/c curl.exe -s --max-time 15 -X POST -H ""Content-Type: application/json"" " & _
               "--data-binary ""@" & sIn & """ " & sUrl & " -o """ & sOut & """ -w ""%%{http_code}"" > """ & sSt & """"
        Shell "cmd.exe", 1, sCmd, True
    Else
        sCmd = "curl -s --max-time 15 -X POST -H 'Content-Type: application/json' " & _
               "--data-binary '@" & sIn & "' " & sUrl & " -o '" & sOut & "' -w '%{http_code}' > '" & sSt & "'"
        Shell "/bin/sh", 1, "-c " & Chr(34) & sCmd & Chr(34), True
    End If

    If FileExists(sSt) Then sHttp = Main.ExtractDigits(Main.ReadUTF8(sSt))
    If FileExists(sOut) Then sResp = Trim(Main.ReadUTF8(sOut))

    ' Если HTTP вернулся (даже 4xx/5xx) — считаем что связь была.
    ' False возвращаем только при полном отсутствии ответа.
    If sHttp = "" And sResp = "" Then Exit Function
    PostJson = True
End Function

' GET URL через curl.
Function GetUrl(sUrl As String, ByRef sResp As String, ByRef sHttp As String) As Boolean
    GetUrl = False
    sResp = "" : sHttp = ""

    Dim oPS As Object : oPS = CreateUnoService("com.sun.star.util.PathSettings")
    Dim sTmp As String : sTmp = ConvertFromURL(oPS.Temp)
    Dim sSep As String : sSep = IIf(GetGUIType() = 1, "\", "/")
    Dim sOut As String : sOut = sTmp & sSep & "ai_dict_out.txt"
    Dim sSt  As String : sSt  = sTmp & sSep & "ai_dict_status.txt"

    If FileExists(sOut) Then Kill sOut
    If FileExists(sSt) Then Kill sSt

    Dim sCmd As String
    If GetGUIType() = 1 Then
        sCmd = "/c curl.exe -s --max-time 10 " & sUrl & _
               " -o """ & sOut & """ -w ""%%{http_code}"" > """ & sSt & """"
        Shell "cmd.exe", 1, sCmd, True
    Else
        sCmd = "curl -s --max-time 10 " & sUrl & _
               " -o '" & sOut & "' -w '%{http_code}' > '" & sSt & "'"
        Shell "/bin/sh", 1, "-c " & Chr(34) & sCmd & Chr(34), True
    End If

    If FileExists(sSt) Then sHttp = Main.ExtractDigits(Main.ReadUTF8(sSt))
    If FileExists(sOut) Then sResp = Trim(Main.ReadUTF8(sOut))
    If sHttp = "" And sResp = "" Then Exit Function
    GetUrl = True
End Function


' ═══════════════════════════════════════════════════
'  МИНИМАЛЬНЫЙ JSON
' ═══════════════════════════════════════════════════
' Экранируем символы для JSON-строки. На стороне клиента валидируем заранее,
' но безопаснее экранировать всё что может встретиться.
Function EscapeJsonString(s As String) As String
    Dim r As String : r = ""
    Dim i As Integer
    For i = 1 To Len(s)
        Dim ch As String : ch = Mid(s, i, 1)
        Select Case ch
            Case Chr(34) : r = r & "\" & Chr(34)
            Case "\"     : r = r & "\\"
            Case Chr(8)  : r = r & "\b"
            Case Chr(9)  : r = r & "\t"
            Case Chr(10) : r = r & "\n"
            Case Chr(12) : r = r & "\f"
            Case Chr(13) : r = r & "\r"
            Case Else    : r = r & ch
        End Select
    Next i
    EscapeJsonString = r
End Function

' Достаёт число после "total": из JSON-ответа сервера. На ошибки возвращает "?".
Function ExtractTotal(sJson As String) As String
    Dim p As Integer : p = InStr(sJson, """total"":")
    If p = 0 Then ExtractTotal = "?" : Exit Function
    Dim i As Integer : i = p + Len("""total"":")
    Dim r As String : r = ""
    Do While i <= Len(sJson)
        Dim ch As String : ch = Mid(sJson, i, 1)
        If ch >= "0" And ch <= "9" Then
            r = r & ch
        ElseIf r <> "" Then
            Exit Do
        ElseIf ch <> " " Then
            Exit Do
        End If
        i = i + 1
    Loop
    If r = "" Then ExtractTotal = "?" Else ExtractTotal = r
End Function

' Достаёт массив "words": ["a","b",...] из JSON-ответа /dict/list и возвращает
' плоскую строку — слова разделены Chr(10) (LF). Возврат массива из Function
' в StarBasic не поддерживается стабильно (As String() / Variant с типизированным
' массивом — компилятор может упасть с «Неожиданный символ: (.»). Поэтому
' конкатенируем и оставляем Split() на стороне вызывающего.
Function ExtractWordsJoined(sJson As String) As String
    ExtractWordsJoined = ""
    Dim p As Integer : p = InStr(sJson, """words""")
    If p = 0 Then Exit Function
    Dim pBr As Integer : pBr = InStr(p, sJson, "[")
    If pBr = 0 Then Exit Function
    Dim pEnd As Integer : pEnd = InStr(pBr, sJson, "]")
    If pEnd = 0 Then pEnd = Len(sJson)

    Dim sBody As String : sBody = Mid(sJson, pBr + 1, pEnd - pBr - 1)
    Dim sOut As String : sOut = ""
    Dim nCount As Integer : nCount = 0

    Dim i As Integer : i = 1
    Do While i <= Len(sBody)
        Dim ch As String : ch = Mid(sBody, i, 1)
        If ch = Chr(34) Then
            ' Начало строки, ищем закрывающую "; учитываем \" внутри.
            Dim sWord As String : sWord = ""
            i = i + 1
            Do While i <= Len(sBody)
                Dim ch2 As String : ch2 = Mid(sBody, i, 1)
                If ch2 = "\" And i < Len(sBody) Then
                    Dim ch3 As String : ch3 = Mid(sBody, i + 1, 1)
                    Select Case ch3
                        Case Chr(34) : sWord = sWord & Chr(34)
                        Case "\"     : sWord = sWord & "\"
                        Case "n"     : sWord = sWord & Chr(10)
                        Case "t"     : sWord = sWord & Chr(9)
                        Case Else    : sWord = sWord & ch3
                    End Select
                    i = i + 2
                ElseIf ch2 = Chr(34) Then
                    Exit Do
                Else
                    sWord = sWord & ch2
                    i = i + 1
                End If
            Loop
            If nCount > 0 Then sOut = sOut & Chr(10)
            sOut = sOut & sWord
            nCount = nCount + 1
        End If
        i = i + 1
    Loop

    ExtractWordsJoined = sOut
End Function

]]></script:module>
